# Entorno Python
.venv/
__pycache__/
*.pyc

# macOS
.DS_Store

# Archivo heredado del Drive de la facu (1.4GB de PDFs/imágenes) — queda solo local
materias/*/archivo/
_drive/

# Claude local (settings personales, no compartir)
.claude/settings.local.json

# Node (toolchain de docx) — se restaura con `npm install`
node_modules/

# HTML intermedio de md-to-pdf (referencia fuentes de KaTeX por ruta local, no es portable)
materias/*/estudio/*.html

# Figuras rasterizadas para el .pptx — derivadas del anexo gráfico, se regeneran
# con scripts/pptx-asi-etapa3/render-figs.py + Chrome headless
materias/*/figs/presentacion/
