# Entorno Python
.venv/
__pycache__/
*.pyc

# macOS
.DS_Store

# Archivo heredado del Drive de la facu (1.4GB de PDFs/imágenes) — queda solo local
materias/*/archivo/
_drive/

# Claude local (settings personales, no compartir)
.claude/settings.local.json

# Node (toolchain de docx) — se restaura con `npm install`
node_modules/

# Salidas y archivos temporales generados localmente
/output/
/tmp/
*.original.alp
*.alp.autosave

# HTML intermedio de md-to-pdf (referencia fuentes de KaTeX por ruta local, no es portable)
materias/*/estudio/*.html

# Figuras rasterizadas para el .pptx — derivadas del anexo gráfico, se regeneran
# con scripts/pptx-asi-etapa3/render-figs.py + Chrome headless
materias/*/figs/presentacion/

# IPP: instaladores de Bizagi (389MB de .exe, se bajan de bizagi.com)
materias/IPP/fuentes/**/*.exe

# SIM TPI (caso CASER): planillas reales de producción de la empresa (Casermeiro
# SRL, en concurso preventivo). El repo es público (github.com/JuanBonadeo/utn_brain),
# así que estos datos quedan solo en local — nunca se suben. Ver decisión 2026-09-22.
materias/SIM/entregables/TPI/caser/datos-locales/

# SIM TPI (subte): filas de la demo sintética escritas por PeatonalCorridasDemo; no son resultados
materias/SIM/entregables/TPI/subte/corridas_peatonales_demo.csv

# SIM: documento de trabajo del TPI 2025 de otro grupo (hospital). Se consulta en
# local pero no se publica: el repo es público. Decisión D8, 2026-09-24.
materias/SIM/fuentes/Trabajo práctico integrador - Simulación de Hospital con Ambulancias.docx
