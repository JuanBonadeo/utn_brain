				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1800000000144</Id>
					<Name><![CDATA[media]]></Name>
					<X>1700</X><Y>568</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[v]]></Name>
						<Type><![CDATA[java.util.ArrayList<Double>]]></Type>
					</Parameter>
					<Body><![CDATA[if (v.isEmpty()) return Double.NaN;
double s = 0;
for (double d : v) s += d;
return s / v.size();]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1800000000145</Id>
					<Name><![CDATA[cuantil]]></Name>
					<X>1700</X><Y>590</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[v]]></Name>
						<Type><![CDATA[java.util.ArrayList<Double>]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[p]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[// Rango mas proximo: ceil(p n), igual que en el analisis de los datos reales.
if (v.isEmpty()) return Double.NaN;
java.util.ArrayList<Double> c = new java.util.ArrayList<Double>(v);
java.util.Collections.sort(c);
int k = (int) Math.ceil(p * c.size());
return c.get(Math.max(0, Math.min(c.size() - 1, k - 1)));]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
