				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1840000000015</Id>
					<Name><![CDATA[acumularVis]]></Name>
					<X>1900</X><Y>922</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Solo presentación: tiempo por estado y área de kg en cola desde t = 0 (no depende del calentamiento).
double t = time();
double dt = t - tUltimoVis;
visHoras[estadoVis()] += dt;
visAreaKg += kgEnCola * dt;
tUltimoVis = t;]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
