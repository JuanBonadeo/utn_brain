					<Parameter>
						<Name><![CDATA[k]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[return visHoras[k] + (estadoVis() == k ? time() - tUltimoVis : 0);]]></Body>
				</Function>
