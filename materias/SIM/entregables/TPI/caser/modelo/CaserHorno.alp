</X><Y>791</Y><Label><X>10</X><Y>0</Y></Label><PublicFlag>true</PublicFlag><PresentationFlag>true</PresentationFlag><ShowLabel>false</ShowLabel><DrawMode>SHAPE_DRAW_2D3D</DrawMode><EmbeddedIcon>false</EmbeddedIcon><Z>0</Z><Rotation>0.0</Rotation><Color>-15368131</Color><Text>−18,0 M$/año · +1,1 días</Text><Font><Name>SansSerif</Name><Size>11</Size><Style>1</Style></Font><Alignment>LEFT</Alignment></Text><Text><Id>1840000000207</Id><Name>txtCtrlVel</Name><X>932</X><Y>728</Y><Label><X>10</X><Y>0</Y></Label><PublicFlag>true</PublicFlag><PresentationFlag>true</PresentationFlag><ShowLabel>false</ShowLabel><DrawMode>SHAPE_DRAW_2D3D</DrawMode><EmbeddedIcon>false</EmbeddedIcon><Z>0</Z><Rotation>0.0</Rotation><Color>-9735040</Color><Text>Velocidad</Text><Font><Name>SansSerif</Name><Size>11</Size><Style>1</Style></Font><Alignment>LEFT</Alignment></Text><Control Type="Button"><EmbeddedIcon>false</EmbeddedIcon><Id>1840000000208</Id><Name>btnCampana</Name><X>932</X><Y>750</Y><Label><X>0</X><Y>-10</Y></Label><PublicFlag>true</PublicFlag><PresentationFlag>true</PresentationFlag><ShowLabel>false</ShowLabel><DrawMode>SHAPE_DRAW_2D3D</DrawMode><BasicProperties Width="210" Height="26"><EmbeddedIcon>false</EmbeddedIcon><TextColor/><Enabled>true</Enabled><ActionCode>getEngine().setRealTimeMode(true);
