<StartupCode>inicializar();
eMuestreo.restart(0);</StartupCode><Functions><Function AccessType="public" StaticFunction="false"><ReturnModificator>VOID</ReturnModificator><ReturnType>void</ReturnType>
<Id>1800000000120</Id><Name>inicializar</Name><X>1700</X><Y>40</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label>
<Body>if (umbralULI &lt; 1) throw new IllegalArgumentException("umbralULI debe ser &gt;= 1: " + umbralULI);
if (minPorULI &lt;= 0 || hCalentamiento &lt; 0 || hEnfriamiento &lt; 0 || horasEnVacio &lt; 0)
    throw new IllegalArgumentException("tiempos del horno invalidos");
if (!(esperaMaxDias &gt; 0)) throw new IllegalArgumentException("esperaMaxDias debe ser &gt; 0 (infinito = sin limite)");
if (!modoFinCampana.equals("workConserving") &amp;&amp; !modoFinCampana.equals("cupo"))
    throw new IllegalArgumentException("modoFinCampana debe ser workConserving o cupo: " + modoFinCampana);
if (pPrioridad &lt; 0 || pPrioridad &gt; 1) throw new IllegalArgumentException("pPrioridad fuera de [0,1]");
if (factorDemanda &lt; 0) throw new IllegalArgumentException("factorDemanda negativo");
if (modoLlegadas.equals("semanas")) {
    if (llegadasSemanas == null || llegadasSemanas.length &lt; 5 || llegadasSemanas.length % 5 != 0)
        throw new IllegalArgumentException("llegadasSemanas debe tener 5 valores (lun-vie) por semana");
} else if (modoLlegadas.equals("poisson")) {
    if (tasaPoissonPorHora &lt;= 0) throw new IllegalArgumentException("tasaPoissonPorHora debe ser &gt; 0");
} else throw new IllegalArgumentException("modoLlegadas debe ser semanas o poisson: " + modoLlegadas);
if (kgCuantiles == null || kgCuantiles.length &lt; 2) throw new IllegalArgumentException("kgCuantiles vacio");
// Un generador por fuente de aleatoriedad: con la misma semilla, las llegadas, los kg y las urgencias
// son identicos en todos los escenarios (numeros aleatorios comunes).
rngLlegadas = new java.util.Random(semilla * 10 + 1);
rngKg = new java.util.Random(semilla * 10 + 2);
rngUrgente = new java.util.Random(semilla * 10 + 3);
rngDemanda = new java.util.Random(semilla * 10 + 4);
rngCiclo = new java.util.Random(semilla * 10 + 5);
tUltimo = time();
midiendo = calentamientoModeloDias &lt;= 0;
tInicioMedicion = midiendo ? time() : calentamientoModeloDias * 24;
if (!midiendo) eInicioMedicion.restart(calentamientoModeloDias * 24);
eFin.restart((Math.max(0, calentamientoModeloDias) + horizonteDias) * 24);
if (modoLlegadas.equals("semanas")) eDia.restart(0);
else eLlegada.restart(exponencial(tasaPoissonPorHora, rngLlegadas));
traceln("HORNO " + escenario + " semilla=" + semilla + " umbral=" + umbralULI + " esperaMax=" + esperaMaxDias
    + " vacio=" + horasEnVacio + "h modo=" + modoFinCampana + " pPrioridad=" + pPrioridad + " demanda=" + factorDemanda);</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>double</ReturnType>
<Id>1800000000121</Id><Name>exponencial</Name><X>1700</X><Y>62</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label>
<Parameter><Name>tasa</Name><Type>double</Type></Parameter><Parameter><Name>r</Name><Type>java.util.Random</Type></Parameter><Body>return -Math.log(1 - r.nextDouble()) / tasa;</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>double</ReturnType>
<Id>1800000000122</Id><Name>tiempoCiclo</Name><X>1700</X><Y>84</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label>
<Body>return cicloExponencial ? exponencial(60.0 / minPorULI, rngCiclo) : minPorULI / 60.0;</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>double</ReturnType>
<Id>1800000000123</Id><Name>muestraKg</Name><X>1700</X><Y>106</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label>
<Body>double u = rngKg.nextDouble() * (kgCuantiles.length - 1);
int i = (int) Math.floor(u);
if (i &gt;= kgCuantiles.length - 1) return kgCuantiles[kgCuantiles.length - 1];
return kgCuantiles[i] + (u - i) * (kgCuantiles[i + 1] - kgCuantiles[i]);</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>VOID</ReturnModificator><ReturnType>void</ReturnType>
<Id>1800000000124</Id><Name>nuevoDia</Name><X>1700</X><Y>128</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label>
<Body>// Lavado de lunes a viernes. Cada lunes se sortea una semana real completa de las observadas
// (bootstrap por bloques: conserva los dias sin lavado y la autocorrelacion dentro de la semana).
int dia = (int) Math.floor(time() / 24 + 1e-9);
int dow = dia % 7;
if (dow == 0) semanaActual = rngLlegadas.nextInt(llegadasSemanas.length / 5);
if (dow &gt;= 5) return;
int base = llegadasSemanas[semanaActual * 5 + dow];
int n = 0;
for (int i = 0; i &lt; base; i++) {
    n += (int) Math.floor(factorDemanda);
    if (rngDemanda.nextDouble() &lt; factorDemanda - Math.floor(factorDemanda)) n++;
}
java.util.ArrayList&lt;Double&gt; horas = new java.util.ArrayList&lt;Double&gt;();
for (int i = 0; i &lt; n; i++) horas.add(dia * 24 + 6 + rngLlegadas.nextDouble() * 16);  // entre las 6 y las 22
java.util.Collections.sort(horas);
llegadasPendientes.addAll(horas);
if (!llegadasPendientes.isEmpty() &amp;&amp; !eLlegada.isActive()) eLlegada.restart(Math.max(0, llegadasPendientes.get(0) - time()));</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>VOID</ReturnModificator><ReturnType>void</ReturnType>
<Id>1800000000125</Id><Name>llegada</Name><X>1700</X><Y>150</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label>
<Body>if (modoLlegadas.equals("poisson")) {
    source.inject(1);
    eLlegada.restart(exponencial(tasaPoissonPorHora, rngLlegadas));
    return;
}
while (!llegadasPendientes.isEmpty() &amp;&amp; llegadasPendientes.get(0) &lt;= time() + 1e-9) {
    llegadasPendientes.remove(0);
    source.inject(1);
}
if (!llegadasPendientes.isEmpty()) eLlegada.restart(Math.max(0, llegadasPendientes.get(0) - time()));</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>VOID</ReturnModificator><ReturnType>void</ReturnType>
<Id>1800000000126</Id><Name>entraCola</Name><X>1700</X><Y>172</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label>
<Parameter><Name>u</Name><Type>ULI</Type></Parameter><Body>acumular();
u.tLlegada = time();
u.kg = muestraKg();
u.urgente = rngUrgente.nextDouble() &lt; pPrioridad;
u.enCupo = false;
u.despachado = false;
nEnCola++;
nCreadas++;
kgEnCola += u.kg;
if (midiendo) nLlegadas++;
evaluarEncendido();
pedirDespacho();</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>VOID</ReturnModificator><ReturnType>void</ReturnType>
<Id>1800000000127</Id><Name>evaluarEncendido</Name><X>1700</X><Y>194</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label>
<Body>if (estado == 0 &amp;&amp; nEnCola &gt; 0) {
    acumular();
    estado = 1;
    if (!Double.isInfinite(esperaMaxDias))
        eEsperaMax.restart(Math.max(0, esperaMaxDias * 24 - (time() - llegadaMasVieja())));
}
if (estado == 1) {
    if (nEnCola &gt;= umbralULI) encender(false);
    else if (hayUrgenteEnCola()) encender(true);
}</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>double</ReturnType>
<Id>1800000000128</Id><Name>llegadaMasVieja</Name><X>1700</X><Y>216</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label>
<Body>double t = time();
for (Agent a : colaHorno) { ULI u = (ULI) a; if (!u.despachado &amp;&amp; u.tLlegada &lt; t) t = u.tLlegada; }
return t;</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>boolean</ReturnType>
<Id>1800000000129</Id><Name>hayUrgenteEnCola</Name><X>1700</X><Y>238</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label>
<Body>for (Agent a : colaHorno) { ULI u = (ULI) a; if (!u.despachado &amp;&amp; u.urgente) return true; }
return false;</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>VOID</ReturnModificator><ReturnType>void</ReturnType>
<Id>1800000000130</Id><Name>encender</Name><X>1700</X><Y>260</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label>
<Parameter><Name>porPrioridad</Name><Type>boolean</Type></Parameter><Body>acumular();
eEsperaMax.reset();
estado = 2;
campanaPrioridad = porPrioridad;
tEncendido = time();
visEncendidos++;
campanaMedida = midiendo;
if (campanaMedida) {
    nEncendidos++;
    if (porPrioridad) nEncendidosPrioridad++;
    sumaColaAlEncender += nEnCola;
}
ulisCampana = 0;
kgCampana = 0;
tPrimerCiclo = -1;
tUltimoCiclo = -1;
eCalentamiento.restart(hCalentamiento);</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>VOID</ReturnModificator><ReturnType>void</ReturnType>
<Id>1800000000131</Id><Name>finCalentamiento</Name><X>1700</X><Y>282</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label>
<Body>acumular();
estado = 3;
enVacio = false;
// Modo cupo (regla del 27/09): la campana trata solo lo que estaba en cola al llegar a temperatura,
// mas las urgentes que lleguen despues. En workConserving no se marca nada.
if (modoFinCampana.equals("cupo") &amp;&amp; !campanaPrioridad)
    for (Agent a : colaHorno) { ULI u = (ULI) a; if (!u.despachado) u.enCupo = true; }
pedirDespacho();</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>VOID</ReturnModificator><ReturnType>void</ReturnType>
<Id>1800000000132</Id><Name>pedirDespacho</Name><X>1700</X><Y>304</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label>
<Body>if (!eDespacho.isActive()) eDespacho.restart(0);</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>VOID</ReturnModificator><ReturnType>void</ReturnType>
<Id>1800000000133</Id><Name>despachar</Name><X>1700</X><Y>326</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label>
<Body>if (estado != 3 || ocupado) return;
acumularVis();
ULI sig = elegirSiguiente();
if (sig == null) {
    if (!enVacio) {
        enVacio = true;
        eVacio.restart(campanaPrioridad &amp;&amp; soloUrgentesEnPrioridad ? 0 : horasEnVacio);
    }
    return;
}
if (enVacio) { enVacio = false; eVacio.reset(); }
acumular();
sig.despachado = true;
sig.tInicio = time();
uliEnHorno = sig;
nEnCola--;
kgEnCola -= sig.kg;
ocupado = true;
if (tPrimerCiclo &lt; 0) tPrimerCiclo = time();
if (midiendo) esperas.add(time() - sig.tLlegada);
visSumaEspera += time() - sig.tLlegada;
visNEspera++;
if (!colaHorno.free(sig)) throw new IllegalStateException("colaHorno.free fallo para una ULI en cola");</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>ULI</ReturnType>
<Id>1800000000134</Id><Name>elegirSiguiente</Name><X>1700</X><Y>348</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label>
<Body>// Urgentes primero; entre iguales, la mas vieja (FIFO).
ULI mejor = null;
for (Agent a : colaHorno) {
    ULI u = (ULI) a;
    if (u.despachado) continue;
    boolean candidata;
    if (campanaPrioridad &amp;&amp; soloUrgentesEnPrioridad) candidata = u.urgente;
    else if (modoFinCampana.equals("cupo")) candidata = u.urgente || u.enCupo;
    else candidata = true;
    if (!candidata) continue;
    if (mejor == null || (u.urgente &amp;&amp; !mejor.urgente) || (u.urgente == mejor.urgente &amp;&amp; u.tLlegada &lt; mejor.tLlegada)) mejor = u;
}
return mejor;</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>VOID</ReturnModificator><ReturnType>void</ReturnType>
<Id>1800000000135</Id><Name>finCiclo</Name><X>1700</X><Y>370</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label>
<Parameter><Name>u</Name><Type>ULI</Type></Parameter><Body>acumular();
ocupado = false;
uliEnHorno = null;
nSalidasTotal++;
ulisCampana++;
kgCampana += u.kg;
visTratadas++;
visKg += u.kg;
kgSalidaTotal += u.kg;
tUltimoCiclo = u.tInicio;
if (midiendo) {
    nTratadas++;
    kgTratados += u.kg;
    sumaSistema += time() - u.tLlegada;
}
pedirDespacho();</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>VOID</ReturnModificator><ReturnType>void</ReturnType>
<Id>1800000000136</Id><Name>finVacio</Name><X>1700</X><Y>392</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label>
<Body>if (estado != 3 || ocupado) return;
acumular();
enVacio = false;
cerrarCampana();
estado = 4;
eEnfriamiento.restart(hEnfriamiento);</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>VOID</ReturnModificator><ReturnType>void</ReturnType>
<Id>1800000000137</Id><Name>cerrarCampana</Name><X>1700</X><Y>414</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label>
<Body>if (!campanaMedida) return;
ulisPorCampana.add((double) ulisCampana);
kgPorCampana.add(kgCampana);
prioridadPorCampana.add(campanaPrioridad);
// Igual que en el registro: dias calendario entre el primer y el ultimo cementado.
diasPorCampana.add(tPrimerCiclo &lt; 0 ? 0.0 : Math.floor(tUltimoCiclo / 24) - Math.floor(tPrimerCiclo / 24) + 1);
sumaColaAlApagar += nEnCola;</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>VOID</ReturnModificator><ReturnType>void</ReturnType>
<Id>1800000000138</Id><Name>finEnfriamiento</Name><X>1700</X><Y>436</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label>
<Body>acumular();
estado = 0;
evaluarEncendido();</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>VOID</ReturnModificator><ReturnType>void</ReturnType>
<Id>1800000000139</Id><Name>esperaMaxCumplida</Name><X>1700</X><Y>458</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label>
<Body>if (estado == 1 &amp;&amp; nEnCola &gt; 0) encender(false);</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>VOID</ReturnModificator><ReturnType>void</ReturnType>
<Id>1800000000140</Id><Name>acumular</Name><X>1700</X><Y>480</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label>
<Body>acumularVis();
double t = time();
if (midiendo) {
    double dt = t - tUltimo;
    areaCola += nEnCola * dt;
    areaColaKg += kgEnCola * dt;
    areaSistema += (nEnCola + (ocupado ? 1 : 0)) * dt;
    if (ocupado) horasOcupado += dt;
    if (estado == 3) horasCaliente += dt;
}
tUltimo = t;</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>VOID</ReturnModificator><ReturnType>void</ReturnType>
<Id>1800000000141</Id><Name>inicioMedicion</Name><X>1700</X><Y>502</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label>
<Body>acumular();
midiendo = true;
tInicioMedicion = time();
nLlegadas = 0; nTratadas = 0; kgTratados = 0; nEncendidos = 0; nEncendidosPrioridad = 0;
sumaColaAlEncender = 0; sumaColaAlApagar = 0; areaCola = 0; areaColaKg = 0; areaSistema = 0;
horasOcupado = 0; horasCaliente = 0; sumaSistema = 0;
esperas.clear(); ulisPorCampana.clear(); kgPorCampana.clear(); diasPorCampana.clear(); prioridadPorCampana.clear();</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>VOID</ReturnModificator><ReturnType>void</ReturnType>
<Id>1800000000142</Id><Name>finCorrida</Name><X>1700</X><Y>524</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label>
<Body>acumular();
emitirResultado();
finalizado = true;
finishSimulation();</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>double</ReturnType>
<Id>1800000000143</Id><Name>horasMedidas</Name><X>1700</X><Y>546</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label>
<Body>return time() - tInicioMedicion;</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>double</ReturnType>
<Id>1800000000144</Id><Name>media</Name><X>1700</X><Y>568</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label>
<Parameter><Name>v</Name><Type>java.util.ArrayList&lt;Double&gt;</Type></Parameter><Body>if (v.isEmpty()) return Double.NaN;
double s = 0;
for (double d : v) s += d;
return s / v.size();</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>double</ReturnType>
<Id>1800000000145</Id><Name>cuantil</Name><X>1700</X><Y>590</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label>
<Parameter><Name>v</Name><Type>java.util.ArrayList&lt;Double&gt;</Type></Parameter><Parameter><Name>p</Name><Type>double</Type></Parameter><Body>// Rango mas proximo: ceil(p n), igual que en el analisis de los datos reales.
if (v.isEmpty()) return Double.NaN;
java.util.ArrayList&lt;Double&gt; c = new java.util.ArrayList&lt;Double&gt;(v);
java.util.Collections.sort(c);
int k = (int) Math.ceil(p * c.size());
return c.get(Math.max(0, Math.min(c.size() - 1, k - 1)));</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>double</ReturnType>
<Id>1800000000146</Id><Name>kWhTotal</Name><X>1700</X><Y>612</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label>
<Body>return kWhPorEncendido * nEncendidos + kWhPorDiaCaliente / 24 * horasCaliente;</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>double</ReturnType>
<Id>1800000000147</Id><Name>campanasPorMes</Name><X>1700</X><Y>634</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label>
<Body>return nEncendidos / (horasMedidas() / (24 * 30.4375));</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>String</ReturnType>
<Id>1800000000148</Id><Name>nombreEstado</Name><X>1700</X><Y>656</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label>
<Body>switch (estado) {
    case 0: return "Apagado";
    case 1: return "Acumulando";
    case 2: return "Calentando";
    case 3: return enVacio ? "Caliente en vacio" : "Cargando";
    case 4: return "Enfriando";
    default: return "?";
}</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>String</ReturnType>
<Id>1800000000149</Id><Name>encabezado</Name><X>1700</X><Y>678</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label>
<Body>return "escenario;semilla;umbralULI;esperaMaxDias;horasEnVacio;modoFinCampana;pPrioridad;factorDemanda;minPorULI;"
    + "horasMedidas;nLlegadas;nTratadas;kgTratados;nEncendidos;nEncendidosPrioridad;campanasPorMes;"
    + "uliPorCampanaMedia;uliPorCampanaMediana;diasPorCampanaMedia;colaAlEncenderMedia;colaAlApagarMedia;"
    + "esperaMediaDias;esperaP90Dias;esperaMaximaDias;colaMediaULI;colaMediaKg;sistemaMedioULI;sistemaMedioHoras;"
    + "utilizacion;fraccionCaliente;kWhTotal;kWhPorKg;costoEnergiaPorKg;glpKg;costoLuz;costoGLP;costoCapital;costoTotal";</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>String</ReturnType>
<Id>1800000000150</Id><Name>filaResultado</Name><X>1700</X><Y>700</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label>
<Body>double h = horasMedidas();
java.util.ArrayList&lt;Double&gt; esperasDias = new java.util.ArrayList&lt;Double&gt;();
for (double e : esperas) esperasDias.add(e / 24);
int nc = ulisPorCampana.size();
double[] v = {
    umbralULI, esperaMaxDias, horasEnVacio, pPrioridad, factorDemanda, minPorULI,
    h, nLlegadas, nTratadas, kgTratados, nEncendidos, nEncendidosPrioridad, campanasPorMes(),
    media(ulisPorCampana), cuantil(ulisPorCampana, 0.5), media(diasPorCampana),
    nEncendidos &gt; 0 ? sumaColaAlEncender / nEncendidos : Double.NaN, nc &gt; 0 ? sumaColaAlApagar / nc : Double.NaN,
    media(esperasDias), cuantil(esperasDias, 0.9), esperasDias.isEmpty() ? Double.NaN : java.util.Collections.max(esperasDias),
    areaCola / h, areaColaKg / h, areaSistema / h, nTratadas &gt; 0 ? sumaSistema / nTratadas : Double.NaN,
    horasOcupado / h, horasCaliente / h, kWhTotal(), kWhTotal() / kgTratados, kWhTotal() / kgTratados * tarifaKWh,
    glpKg(), costoLuz(), costoGLP(), costoCapital(), costoTotal() };
StringBuilder sb = new StringBuilder(escenario + ";" + semilla);
for (int i = 0; i &lt; v.length; i++) {
    if (i == 3) sb.append(";").append(modoFinCampana);
    sb.append(";").append(String.format(java.util.Locale.US, "%.6g", v[i]));
}
return sb.toString();</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>VOID</ReturnModificator><ReturnType>void</ReturnType>
<Id>1800000000151</Id><Name>emitirResultado</Name><X>1700</X><Y>722</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label>
<Body>String fila = filaResultado();
traceln("CSV_HORNO;" + fila);
traceln(String.format(java.util.Locale.US,
    "RESUMEN %s semilla=%d: encendidos=%d (prioridad %d), %.2f campanas/mes, ULI/campana media %.1f, espera media %.2f d, p90 %.2f d, kWh/kg %.3f, costo total %.1f M$ (luz %.1f, gas %.1f, capital %.1f)",
    escenario, semilla, nEncendidos, nEncendidosPrioridad, campanasPorMes(), media(ulisPorCampana),
    media(esperas) / 24, cuantil(esperas, 0.9) / 24, kWhTotal() / kgTratados,
    costoTotal() / 1e6, costoLuz() / 1e6, costoGLP() / 1e6, costoCapital() / 1e6));
if (archivoSalida == null || archivoSalida.isEmpty()) return;
synchronized (java.io.File.class) {
    try {
        java.io.File f = new java.io.File(archivoSalida);
        boolean nuevo = !f.exists() || f.length() == 0;
        java.io.FileWriter w = new java.io.FileWriter(f, true);
        if (nuevo) w.write(encabezado() + "\n");
        w.write(fila + "\n");
        w.close();
    } catch (java.io.IOException ex) {
        throw new RuntimeException("No se pudo escribir " + archivoSalida, ex);
    }
}</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>java.awt.Color</ReturnType><Id>1810000000057</Id><Name>colorHorno</Name><X>1700</X><Y>1000</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Body>if (estado == 3 &amp;&amp; enVacio) return new java.awt.Color(245, 150, 120);
if (estado == 0) return new java.awt.Color(200, 200, 200);
if (estado == 1) return new java.awt.Color(240, 220, 130);
if (estado == 2) return new java.awt.Color(255, 165, 60);
if (estado == 3) return new java.awt.Color(235, 90, 50);
return new java.awt.Color(150, 180, 230);</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>String</ReturnType><Id>1810000000058</Id><Name>textoHorno</Name><X>1700</X><Y>1022</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Body>switch (estado) {
    case 0: return "Apagado";
    case 1: return "Acumulando: " + nEnCola + " de " + umbralULI + " ULI";
    case 2: return (campanaPrioridad ? "Calentando por prioridad" : "Calentando") + " - faltan " + Math.round(eCalentamiento.getRest()) + " h";
    case 3: return enVacio ? "Caliente sin carga - apaga en " + Math.round(eVacio.getRest()) + " h"
                           : (campanaPrioridad ? "Cargando ULI urgentes" : "Cargando ULI");
    case 4: return "Enfriando - faltan " + Math.round(eEnfriamiento.getRest()) + " h";
    default: return "?";
}</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>double</ReturnType><Id>1810000000059</Id><Name>progresoCiclo</Name><X>1700</X><Y>1044</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Body>if (!ocupado || uliEnHorno == null) return 0;
return Math.max(0, Math.min(1, (time() - uliEnHorno.tInicio) / (minPorULI / 60)));</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>VOID</ReturnModificator><ReturnType>void</ReturnType><Id>1820000000004</Id><Name>muestrear</Name><X>1700</X><Y>1100</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Body>dsCola.add(time(), nEnCola);
dsUmbral.add(time(), umbralULI);
dsEnergia.add(time(), kWhTotal() / 1000);
if (histTick++ % 2 == 0) { histEstado[histIdx] = estadoVis() + 1; histIdx = (histIdx + 1) % histEstado.length; }</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>double</ReturnType><Id>1830000000009</Id><Name>glpKg</Name><X>1700</X><Y>1200</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Body>return kgGLPPorDiaCaliente / 24 * horasCaliente;</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>double</ReturnType><Id>1830000000010</Id><Name>costoLuz</Name><X>1700</X><Y>1222</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Body>return kWhTotal() * tarifaKWh;</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>double</ReturnType><Id>1830000000011</Id><Name>costoGLP</Name><X>1700</X><Y>1244</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Body>return glpKg() * precioGLPkg;</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>double</ReturnType><Id>1830000000012</Id><Name>costoCapital</Name><X>1700</X><Y>1266</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Body>return tasaCapitalMensual * areaColaKg / (24 * 30.4375) * costoProductoKg;</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>double</ReturnType><Id>1830000000013</Id><Name>costoTotal</Name><X>1700</X><Y>1288</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Body>return costoLuz() + costoGLP() + costoCapital();</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>int</ReturnType><Id>1840000000014</Id><Name>estadoVis</Name><X>1900</X><Y>900</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Body>if (estado == 0) return 0;
if (estado == 1) return 1;
if (estado == 2) return 2;
if (estado == 3) return ocupado || !enVacio ? 3 : 4;
return 5;</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>VOID</ReturnModificator><ReturnType>void</ReturnType><Id>1840000000015</Id><Name>acumularVis</Name><X>1900</X><Y>922</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Body>// Solo presentación: tiempo por estado y área de kg en cola desde t = 0 (no depende del calentamiento).
double t = time();
double dt = t - tUltimoVis;
visHoras[estadoVis()] += dt;
visAreaKg += kgEnCola * dt;
tUltimoVis = t;</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>double</ReturnType><Id>1840000000016</Id><Name>visHorasEstado</Name><X>1900</X><Y>944</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Parameter><Name>k</Name><Type>int</Type></Parameter><Body>return visHoras[k] + (estadoVis() == k ? time() - tUltimoVis : 0);</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>double</ReturnType><Id>1840000000017</Id><Name>visHorasTotal</Name><X>1900</X><Y>966</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Body>double h = 0;
for (int k = 0; k &lt; 6; k++) h += visHorasEstado(k);
return h;</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>int</ReturnType><Id>1840000000018</Id><Name>ordenEstado</Name><X>1900</X><Y>988</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Parameter><Name>pos</Name><Type>int</Type></Parameter><Body>// Orden de la barra: lo que cuesta primero.
int[] o = {3, 4, 2, 5, 1, 0};
return o[pos];</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>double</ReturnType><Id>1840000000019</Id><Name>fracEstado</Name><X>1900</X><Y>1010</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Parameter><Name>k</Name><Type>int</Type></Parameter><Body>double h = visHorasTotal();
return h &lt;= 0 ? 0 : visHorasEstado(k) / h;</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>double</ReturnType><Id>1840000000020</Id><Name>fracAcumulada</Name><X>1900</X><Y>1032</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Parameter><Name>pos</Name><Type>int</Type></Parameter><Body>double f = 0;
for (int i = 0; i &lt; pos; i++) f += fracEstado(ordenEstado(i));
return f;</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>java.awt.Color</ReturnType><Id>1840000000021</Id><Name>colorEstado</Name><X>1900</X><Y>1054</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Parameter><Name>k</Name><Type>int</Type></Parameter><Body>java.awt.Color[] c = {new java.awt.Color(200, 204, 210), new java.awt.Color(240, 220, 130), new java.awt.Color(255, 165, 60), new java.awt.Color(235, 90, 50), new java.awt.Color(245, 150, 120), new java.awt.Color(150, 180, 230)};
return k &lt; 0 ? new java.awt.Color(236, 238, 241) : c[k];</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>java.awt.Color</ReturnType><Id>1840000000022</Id><Name>colorHist</Name><X>1900</X><Y>1076</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Parameter><Name>i</Name><Type>int</Type></Parameter><Body>int v = histEstado[(histIdx + i) % histEstado.length];
return colorEstado(v - 1);</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>double</ReturnType><Id>1840000000023</Id><Name>visHorasCaliente</Name><X>1900</X><Y>1098</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Body>return visHorasEstado(3) + visHorasEstado(4);</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>double</ReturnType><Id>1840000000024</Id><Name>visLuz</Name><X>1900</X><Y>1120</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Body>return (kWhPorEncendido * visEncendidos + kWhPorDiaCaliente / 24 * visHorasCaliente()) * tarifaKWh;</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>double</ReturnType><Id>1840000000025</Id><Name>visGas</Name><X>1900</X><Y>1142</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Body>return kgGLPPorDiaCaliente / 24 * visHorasCaliente() * precioGLPkg;</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>double</ReturnType><Id>1840000000026</Id><Name>visCapital</Name><X>1900</X><Y>1164</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Body>double area = visAreaKg + kgEnCola * (time() - tUltimoVis);
return tasaCapitalMensual * area / (24 * 30.4375) * costoProductoKg;</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>double</ReturnType><Id>1840000000027</Id><Name>visTotal</Name><X>1900</X><Y>1186</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Body>return visLuz() + visGas() + visCapital();</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>double</ReturnType><Id>1840000000028</Id><Name>visDesperdicio</Name><X>1900</X><Y>1208</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Body>// Lo que cuesta tener el horno caliente sin carga: luz y gas de esas horas.
return visHorasEstado(4) * (kWhPorDiaCaliente / 24 * tarifaKWh + kgGLPPorDiaCaliente / 24 * precioGLPkg);</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>double</ReturnType><Id>1840000000029</Id><Name>visEsperaMediaDias</Name><X>1900</X><Y>1230</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Body>return visNEspera == 0 ? 0 : visSumaEspera / visNEspera / 24;</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>double</ReturnType><Id>1840000000030</Id><Name>esperaMasViejaDias</Name><X>1900</X><Y>1252</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Body>return nEnCola == 0 ? 0 : (time() - llegadaMasVieja()) / 24;</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>java.awt.Color</ReturnType><Id>1840000000031</Id><Name>colorEdad</Name><X>1900</X><Y>1274</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Parameter><Name>tLleg</Name><Type>double</Type></Parameter><Body>double d = (time() - tLleg) / 24;
if (d &lt; 3) return new java.awt.Color(111, 191, 128);
if (d &lt; 7) return new java.awt.Color(242, 201, 76);
if (d &lt; 14) return new java.awt.Color(242, 153, 74);
return new java.awt.Color(214, 69, 69);</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>double</ReturnType><Id>1840000000032</Id><Name>temperaturaHorno</Name><X>1900</X><Y>1296</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Body>// Ilustrativa: rampa lineal de 25 a 900 °C al calentar y de vuelta al enfriar.
if (estado == 2) return 25 + 875 * Math.max(0, Math.min(1, 1 - eCalentamiento.getRest() / hCalentamiento));
if (estado == 3) return 900;
if (estado == 4) return 25 + 875 * Math.max(0, Math.min(1, eEnfriamiento.getRest() / hEnfriamiento));
return 25;</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>java.awt.Color</ReturnType><Id>1840000000033</Id><Name>colorTemperatura</Name><X>1900</X><Y>1318</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Body>double f = (temperaturaHorno() - 25) / 875;
return new java.awt.Color((int) (90 + 160 * f), (int) (90 - 40 * f), (int) (95 - 70 * f));</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>double</ReturnType><Id>1840000000034</Id><Name>progresoFase</Name><X>1900</X><Y>1340</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Body>if (estado == 2) return 1 - eCalentamiento.getRest() / Math.max(1e-9, hCalentamiento);
if (estado == 4) return 1 - eEnfriamiento.getRest() / Math.max(1e-9, hEnfriamiento);
if (estado == 3 &amp;&amp; enVacio &amp;&amp; horasEnVacio &gt; 0) return 1 - eVacio.getRest() / horasEnVacio;
if (estado == 1) return Math.min(1, nEnCola / (double) umbralULI);
return 0;</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>String</ReturnType><Id>1840000000035</Id><Name>fechaTexto</Name><X>1900</X><Y>1362</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Body>// t = 0 es el lunes 18/08/2025, primera semana de los datos de lavado.
java.time.LocalDate d = java.time.LocalDate.of(2025, 8, 18).plusDays((long) Math.floor(time() / 24));
String f = d.format(java.time.format.DateTimeFormatter.ofPattern("EEEE d 'de' MMMM 'de' yyyy", new java.util.Locale("es", "AR")));
return f.substring(0, 1).toUpperCase() + f.substring(1) + String.format("  ·  %02d:00 h", (int) Math.floor(time() % 24));</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>String</ReturnType><Id>1840000000036</Id><Name>fechaCorta</Name><X>1900</X><Y>1384</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Parameter><Name>t</Name><Type>double</Type></Parameter><Body>return java.time.LocalDateTime.of(2025, 8, 18, 0, 0).plusMinutes(Math.round(t * 60)).format(java.time.format.DateTimeFormatter.ofPattern("EEE dd/MM HH:mm", new java.util.Locale("es", "AR")));</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>String</ReturnType><Id>1840000000037</Id><Name>plata</Name><X>1900</X><Y>1406</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Parameter><Name>pesos</Name><Type>double</Type></Parameter><Body>// Por debajo del millón, en miles: así el número no queda en "$ 0,0 M" al lado de una barra visible.
if (Math.abs(pesos) &lt; 1e6) return String.format(new java.util.Locale("es", "AR"), "$ %,.0f mil", pesos / 1e3);
return String.format(new java.util.Locale("es", "AR"), "$ %.1f M", pesos / 1e6);</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>String</ReturnType><Id>1840000000038</Id><Name>descEscenario</Name><X>1900</X><Y>1428</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Body>String e = escenario.equals("E1") ? "umbral bajo" : escenario.equals("E2") ? "umbral con espera máxima" : escenario.equals("E3") ? "apagar apenas se vacía la cola" : "regla actual";
return "Escenario " + escenario + " · " + e + ":  enciende con " + umbralULI + " ULI  ·  " + (Double.isInfinite(esperaMaxDias) ? "sin espera máxima" : "o si la más vieja lleva " + (int) esperaMaxDias + " días") + "  ·  " + (horasEnVacio &gt; 0 ? "caliente sin carga hasta " + (int) horasEnVacio + " h" : "se apaga apenas se vacía la cola");</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>String</ReturnType><Id>1840000000039</Id><Name>nombreEstadoVis</Name><X>1900</X><Y>1450</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Parameter><Name>k</Name><Type>int</Type></Parameter><Body>String[] n = {"Apagado", "Acumulando", "Calentando", "Procesando", "Caliente sin carga", "Enfriando"};
return n[k];</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>int</ReturnType><Id>1840000000040</Id><Name>escenarioIndice</Name><X>1900</X><Y>1472</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Body>return escenario.equals("E1") ? 1 : escenario.equals("E2") ? 2 : escenario.equals("E3") ? 3 : 0;</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>VOID</ReturnModificator><ReturnType>void</ReturnType><Id>1840000000041</Id><Name>resetVis</Name><X>1900</X><Y>1494</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Body>acumularVis();
for (int k = 0; k &lt; 6; k++) visHoras[k] = 0;
visAreaKg = 0; visEncendidos = 0; visSumaEspera = 0; visNEspera = 0; visTratadas = 0; visKg = 0;
tInicioVis = time();</Body></Function><Function AccessType="public" StaticFunction="false"><ReturnModificator>VOID</ReturnModificator><ReturnType>void</ReturnType><Id>1840000000042</Id><Name>cambiarEscenario</Name><X>1900</X><Y>1516</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Parameter><Name>v</Name><Type>int</Type></Parameter><Body>// Solo para la animación: cambia la regla en vivo. Los contadores siguen sumando (se ve cómo dejan de
// crecer con la regla nueva); para empezar de cero está el botón Reiniciar contadores.
acumularVis();
escenario = v == 1 ? "E1" : v == 2 ? "E2" : v == 3 ? "E3" : "E0";
umbralULI = v == 1 ? 45 : 79;
esperaMaxDias = v == 2 ? 15 : Double.POSITIVE_INFINITY;
horasEnVacio = v == 3 ? 0 : 48;
if (estado == 1) {
    if (Double.isInfinite(esperaMaxDias)) eEsperaMax.reset();
    else eEsperaMax.restart(Math.max(0, esperaMaxDias * 24 - (time() - llegadaMasVieja())));
}
if (estado == 3 &amp;&amp; enVacio) eVacio.restart(Math.max(0, Math.min(eVacio.getRest(), horasEnVacio)));
evaluarEncendido();</Body></Function></Functions><Events><Event><Id>1800000000152</Id><Name>eDia</Name><X>1950</X><Y>40</Y><Label><X>10</X><Y>0</Y></Label><PublicFlag>false</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel>
