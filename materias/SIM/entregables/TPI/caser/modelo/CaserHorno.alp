				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[java.awt.Color]]></ReturnType>
					<Id>1840000000031</Id>
					<Name><![CDATA[colorEdad]]></Name>
					<X>1900</X><Y>1274</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[tLleg]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[double d = (time() - tLleg) / 24;
if (d < 3) return new java.awt.Color(111, 191, 128);
if (d < 7) return new java.awt.Color(242, 201, 76);
if (d < 14) return new java.awt.Color(242, 153, 74);
return new java.awt.Color(214, 69, 69);]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1840000000032</Id>
					<Name><![CDATA[temperaturaHorno]]></Name>
					<X>1900</X><Y>1296</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Ilustrativa: rampa lineal de 25 a 900 °C al calentar y de vuelta al enfriar.
if (estado == 2) return 25 + 875 * Math.max(0, Math.min(1, 1 - eCalentamiento.getRest() / hCalentamiento));
if (estado == 3) return 900;
if (estado == 4) return 25 + 875 * Math.max(0, Math.min(1, eEnfriamiento.getRest() / hEnfriamiento));
return 25;]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[java.awt.Color]]></ReturnType>
					<Id>1840000000033</Id>
					<Name><![CDATA[colorTemperatura]]></Name>
					<X>1900</X><Y>1318</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double f = (temperaturaHorno() - 25) / 875;
return new java.awt.Color((int) (90 + 160 * f), (int) (90 - 40 * f), (int) (95 - 70 * f));]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1840000000034</Id>
					<Name><![CDATA[progresoFase]]></Name>
					<X>1900</X><Y>1340</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (estado == 2) return 1 - eCalentamiento.getRest() / Math.max(1e-9, hCalentamiento);
if (estado == 4) return 1 - eEnfriamiento.getRest() / Math.max(1e-9, hEnfriamiento);
if (estado == 3 && enVacio && horasEnVacio > 0) return 1 - eVacio.getRest() / horasEnVacio;
if (estado == 1) return Math.min(1, nEnCola / (double) umbralULI);
return 0;]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1840000000035</Id>
					<Name><![CDATA[fechaTexto]]></Name>
					<X>1900</X><Y>1362</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// t = 0 es el lunes 18/08/2025, primera semana de los datos de lavado.
java.time.LocalDate d = java.time.LocalDate.of(2025, 8, 18).plusDays((long) Math.floor(time() / 24));
String f = d.format(java.time.format.DateTimeFormatter.ofPattern("EEEE d 'de' MMMM 'de' yyyy", new java.util.Locale("es", "AR")));
return f.substring(0, 1).toUpperCase() + f.substring(1) + String.format("  ·  %02d:00 h", (int) Math.floor(time() % 24));]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1840000000036</Id>
					<Name><![CDATA[fechaCorta]]></Name>
					<X>1900</X><Y>1384</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[return java.time.LocalDateTime.of(2025, 8, 18, 0, 0).plusMinutes(Math.round(t * 60)).format(java.time.format.DateTimeFormatter.ofPattern("EEE dd/MM HH:mm", new java.util.Locale("es", "AR")));]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1840000000037</Id>
					<Name><![CDATA[plata]]></Name>
					<X>1900</X><Y>1406</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[pesos]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[// Por debajo del millón, en miles: así el número no queda en "$ 0,0 M" al lado de una barra visible.
if (Math.abs(pesos) < 1e6) return String.format(new java.util.Locale("es", "AR"), "$ %,.0f mil", pesos / 1e3);
return String.format(new java.util.Locale("es", "AR"), "$ %.1f M", pesos / 1e6);]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1840000000038</Id>
					<Name><![CDATA[descEscenario]]></Name>
					<X>1900</X><Y>1428</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[String e = escenario.equals("E1") ? "umbral bajo" : escenario.equals("E2") ? "umbral con espera máxima" : escenario.equals("E3") ? "apagar apenas se vacía la cola" : "regla actual";
return "Escenario " + escenario + " · " + e + ":  enciende con " + umbralULI + " ULI  ·  " + (Double.isInfinite(esperaMaxDias) ? "sin espera máxima" : "o si la más vieja lleva " + (int) esperaMaxDias + " días") + "  ·  " + (horasEnVacio > 0 ? "caliente sin carga hasta " + (int) horasEnVacio + " h" : "se apaga apenas se vacía la cola");]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1840000000039</Id>
					<Name><![CDATA[nombreEstadoVis]]></Name>
					<X>1900</X><Y>1450</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[k]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[String[] n = {"Apagado", "Acumulando", "Calentando", "Procesando", "Caliente sin carga", "Enfriando"};
return n[k];]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1840000000040</Id>
					<Name><![CDATA[escenarioIndice]]></Name>
					<X>1900</X><Y>1472</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return escenario.equals("E1") ? 1 : escenario.equals("E2") ? 2 : escenario.equals("E3") ? 3 : 0;]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1840000000041</Id>
					<Name><![CDATA[resetVis]]></Name>
					<X>1900</X><Y>1494</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[acumularVis();
for (int k = 0; k < 6; k++) visHoras[k] = 0;
visAreaKg = 0; visEncendidos = 0; visSumaEspera = 0; visNEspera = 0; visTratadas = 0; visKg = 0;
tInicioVis = time();]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1840000000042</Id>
					<Name><![CDATA[cambiarEscenario]]></Name>
					<X>1900</X><Y>1516</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[v]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[// Solo para la animación: cambia la regla en vivo. Los contadores siguen sumando (se ve cómo dejan de
// crecer con la regla nueva); para empezar de cero está el botón Reiniciar contadores.
acumularVis();
escenario = v == 1 ? "E1" : v == 2 ? "E2" : v == 3 ? "E3" : "E0";
umbralULI = v == 1 ? 45 : 79;
esperaMaxDias = v == 2 ? 15 : Double.POSITIVE_INFINITY;
horasEnVacio = v == 3 ? 0 : 48;
if (estado == 1) {
    if (Double.isInfinite(esperaMaxDias)) eEsperaMax.reset();
    else eEsperaMax.restart(Math.max(0, esperaMaxDias * 24 - (time() - llegadaMasVieja())));
}
if (estado == 3 && enVacio) eVacio.restart(Math.max(0, Math.min(eVacio.getRest(), horasEnVacio)));
evaluarEncendido();]]></Body>
				</Function>
			</Functions>
