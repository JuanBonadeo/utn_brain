				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1792000000026</Id>
					<Name><![CDATA[escribirFilaPed]]></Name>
					<X>2000</X><Y>200</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[linea]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (archivoSalidaPed == null || archivoSalidaPed.trim().isEmpty()) return;
// Con evaluaciones en paralelo varias corridas pueden terminar a la vez: se serializa la escritura
// con un monitor unico del JVM para que ninguna linea se intercale con otra.
synchronized (java.nio.file.Files.class) {
try {
    java.nio.file.Path ruta = java.nio.file.Paths.get(archivoSalidaPed).toAbsolutePath();
    java.nio.file.Files.write(ruta, java.util.Collections.singletonList(linea), java.nio.charset.StandardCharsets.UTF_8,
        java.nio.file.StandardOpenOption.CREATE, java.nio.file.StandardOpenOption.APPEND);
    traceln("Fila agregada a " + ruta);
} catch (java.io.IOException e) {
    throw new RuntimeException("No se pudo escribir " + archivoSalidaPed, e);
}
}]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1792000000027</Id>
					<Name><![CDATA[emitirIncompletoPed]]></Name>
					<X>2000</X><Y>235</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Si la inicializacion fallo, el error ya figura en consola y no hay corrida que reportar.
if (resultadoEmitidoPed || !inicializadoPed) return;
resultadoEmitidoPed = true;
String linea = "CSV_PEATONAL_INCOMPLETO;" + filaResultadoPed() + ";inyectados=" + nInyectadosPed + ";t=" + time();
traceln("ADVERTENCIA: la corrida termino sin drenar la cohorte; no usar como replica.");
traceln(resumenPeatonal());
traceln(linea);
escribirFilaPed(linea);]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1793000000010</Id>
					<Name><![CDATA[hallPed]]></Name>
					<X>2000</X><Y>900</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Peatones que ingresaron al vestibulo y todavia no llegaron a un molinete (ni a su cola):
// caminan por la zona no paga. Si crece sin limite, el cuello de botella es el movimiento, no la validacion.
return nGeneradosPed - nLlegadosMolinetePed;]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1793000000011</Id>
					<Name><![CDATA[pagaPed]]></Name>
					<X>2000</X><Y>925</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Peatones que empezaron a validar y todavia no salieron por las escaleras a andenes.
return nEsperasPed - nProcesadosPed;]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1793000000012</Id>
					<Name><![CDATA[actualizarTransitoPed]]></Name>
					<X>2000</X><Y>950</Y>
					<Label><X>10</X><Y>0</Y></Label>
