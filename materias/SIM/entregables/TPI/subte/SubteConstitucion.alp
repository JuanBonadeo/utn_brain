				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[QueuePath]]></ReturnType>
					<Id>1792000000183</Id>
					<Name><![CDATA[elegirColaPed]]></Name>
					<X>2000</X><Y>270</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[ped]]></Name>
						<Type><![CDATA[Pasajero]]></Type>
					</Parameter>
					<Body><![CDATA[// Supuesto de comportamiento (plano hipotetico): cada pasajero elige, entre los molinetes
// habilitados, la cola que minimiza el desvio lateral a 1,3 m/s mas la espera estimada por
// las personas que ya estan en ella. Los molinetes suspendidos nunca se eligen.
java.util.List<QueuePath> colas = molinetesPeatonales.getQueues();
QueuePath mejor = null;
double mejorCosto = Double.MAX_VALUE;
for (int i = 0; i < molinetesOperativosPed && i < colas.size(); i++) {
    QueuePath cola = colas.get(i);
    double desvioSeg = Math.abs(ped.getY() - cola.getEndPoint().y) / 10.0 / 1.3;
    double costo = desvioSeg + molinetesPeatonales.queueSize(cola) * ped.servicioAsignadoPed;
    if (costo < mejorCosto) {
        mejorCosto = costo;
        mejor = cola;
    }
}
if (mejor == null) throw new IllegalStateException("No hay molinetes habilitados");
return mejor;]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1792000000324</Id>
					<Name><![CDATA[programarDemandaFranjaPed]]></Name>
					<X>2000</X><Y>305</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Roca: cada tren del horario oficial trae la parte de la demanda de su ventana que corresponde a los
// trenes de esa ventana; su pasaje ingresa al vestibulo de forma pareja durante duracionDescargaSeg,
// a partir de demoraAccesoRocaSeg. Solo cuentan los ingresos anteriores al cierre (09:30).
double h = horizonteArribosPedSeg;
int[] trenesPorVentana = new int[perfilPed15min.length];
for (double t : llegadasRocaSeg) {
    double ingreso = t + demoraAccesoRocaSeg;
    if (ingreso >= 0 && ingreso < h) trenesPorVentana[(int)Math.floor(ingreso / 900.0)]++;
}
for (double t : llegadasRocaSeg) {
    double ingreso = t + demoraAccesoRocaSeg;
    if (ingreso < 0 || ingreso >= h) continue;
    int ventana = (int)Math.floor(ingreso / 900.0);
    int n = (int)Math.round(factorDemandaPed * perfilPed15min[ventana] * proporcionRocaPed / trenesPorVentana[ventana]);
    nTrenesPed++;
    for (int i = 0; i < n; i++) {
        double r = ingreso + (i + 0.5) * duracionDescargaSeg / n;
        if (r < h) liberacionesPed.add(r);
    }
}
if (liberacionesPed.isEmpty()) {
    rocaCerradoPed = true;
    cerrarArribosSiCorrespondePed();
} else {
    proximaLiberacionPed.restart(Math.max(0, liberacionesPed.peek() - time()));
}
programarLlegadaCallePed(time());]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1792000000325</Id>
					<Name><![CDATA[liberarPendientesPed]]></Name>
					<X>2000</X><Y>340</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[int k = 0;
while (!liberacionesPed.isEmpty() && liberacionesPed.peek() <= time() + 1e-9) {
    liberacionesPed.poll();
    k++;
}
if (k > 0) {
    nTandasPed++;
    tiempoUltimaTandaPed = time();
    nInyectadosPed += k;
    nDesdeRocaPed += k;
    pedSource.inject(k);
}
if (liberacionesPed.isEmpty()) {
    rocaCerradoPed = true;
    cerrarArribosSiCorrespondePed();
} else {
    proximaLiberacionPed.restart(liberacionesPed.peek() - time());
}]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1792000000326</Id>
					<Name><![CDATA[llegadaCallePed]]></Name>
					<X>2000</X><Y>375</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (time() >= horizonteArribosPedSeg) {
    calleCerradaPed = true;
    cerrarArribosSiCorrespondePed();
    return;
}
tiempoUltimaTandaPed = time();
nInyectadosPed++;
nDesdeCallePed++;
pedSourceCalle.inject(1);
programarLlegadaCallePed(time());]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1792000000327</Id>
					<Name><![CDATA[programarLlegadaCallePed]]></Name>
					<X>2000</X><Y>410</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[desde]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[// Poisson no homogeneo por adelgazamiento: la tasa de cada ventana es la parte de calle del perfil SBASE.
double tasaMax = 0;
for (double v : perfilPed15min) tasaMax = Math.max(tasaMax, factorDemandaPed * v * (1 - proporcionRocaPed) / 900.0);
if (tasaMax <= 0) {
    calleCerradaPed = true;
    cerrarArribosSiCorrespondePed();
    return;
}
double t = desde;
while (true) {
    t += -Math.log(1 - rngCallePed.nextDouble()) / tasaMax;
    if (t >= horizonteArribosPedSeg) {
        calleCerradaPed = true;
        cerrarArribosSiCorrespondePed();
        return;
    }
    int ventana = Math.min(perfilPed15min.length - 1, (int)Math.floor(t / 900.0));
    double tasa = factorDemandaPed * perfilPed15min[ventana] * (1 - proporcionRocaPed) / 900.0;
    if (rngCallePed.nextDouble() * tasaMax <= tasa) break;
}
proximaLlegadaCallePed.restart(t - time());]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1792000000328</Id>
					<Name><![CDATA[cerrarArribosSiCorrespondePed]]></Name>
					<X>2000</X><Y>445</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (rocaCerradoPed && calleCerradaPed) arribosCerradosPed = true;]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792000000329</Id>
					<Name><![CDATA[tiempoServicioPed]]></Name>
					<X>2000</X><Y>480</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (servicioMinPedSeg < 0) return servicioPedSeg;
double a = servicioMinPedSeg, c = servicioPedSeg, b = servicioMaxPedSeg;
if (b <= a) return c;
double u = rngServicioPed.nextDouble();
double corte = (c - a) / (b - a);
return u < corte ? a + Math.sqrt(u * (b - a) * (c - a)) : b - Math.sqrt((1 - u) * (b - a) * (b - c));]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1792000000330</Id>
					<Name><![CDATA[caudalPorVentanaPed]]></Name>
					<X>2000</X><Y>515</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Validaciones simuladas por ventana de 15 minutos frente al perfil SBASE escalado (control de calibracion).
java.util.ArrayList<String> partes = new java.util.ArrayList<String>();
for (int w = 0; w < validacionesPorVentanaPed.length && w < perfilPed15min.length; w++) {
    int minutos = 7 * 60 + 15 * w;
    partes.add(String.format(java.util.Locale.US, "%02d:%02d sim=%d obs=%.0f", minutos / 60, minutos % 60,
        validacionesPorVentanaPed[w], factorDemandaPed * perfilPed15min[w]));
}
return String.join(",", partes);]]></Body>
				</Function>
			</Functions>

