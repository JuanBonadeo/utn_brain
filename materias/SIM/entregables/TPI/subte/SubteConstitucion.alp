					</Properties>
					<Action><![CDATA[actualizarTransitoPed();
int minutos = 7 * 60 + (int)Math.floor(time() / 60.0);
traceln(String.format(java.util.Locale.US, "PROGRESO t=%.0f s (%02d:%02d) - hall %d (max %d) - cola %d - zona paga %d - procesados %d/%d - real %.0f s",
    time(), minutos / 60, minutos % 60, hallPed(), hallMaxPed, nEsperandoPed, pagaPed(), nProcesadosPed, nInyectadosPed, segundosRealesPed()));
if (!resultadoEmitidoPed) progresoPed.restart(intervaloProgresoPed());]]></Action>
				</Event>
			</Events>
			<Functions>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1791000000084</Id>
					<Name><![CDATA[actualizarAreaColaPed]]></Name>
					<X>1333</X><Y>-309</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double ahora = Math.min(time(), horizonteCortePed);
areaColaPed += nEsperandoPed * Math.max(0, ahora - tAreaColaPed);
tAreaColaPed = ahora;]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1791000000085</Id>
					<Name><![CDATA[entraColaPed]]></Name>
					<X>1333</X><Y>-393</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[ped]]></Name>
						<Type><![CDATA[Pasajero]]></Type>
					</Parameter>
					<Body><![CDATA[nLlegadosMolinetePed++;
actualizarAreaColaPed();
ped.enColaPed = true;
nEsperandoPed++;
// Igual que Lq, la cola maxima se mide hasta el corte (09:30); el drenaje posterior no cuenta.
if (time() < horizonteCortePed) qMaxPed = Math.max(qMaxPed, nEsperandoPed);]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[long]]></ReturnType>
					<Id>1793000000038</Id>
					<Name><![CDATA[mezclarSemillaPed]]></Name>
					<X>463</X><Y>-239</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[semilla]]></Name>
						<Type><![CDATA[long]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[flujo]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[// Finalizador SplitMix64: semillas vecinas (pares consecutivos, flujos distintos) quedan independientes.
long z = semilla * 0x9E3779B97F4A7C15L + flujo * 0xBF58476D1CE4E5B9L;
z = (z ^ (z >>> 30)) * 0xBF58476D1CE4E5B9L;
z = (z ^ (z >>> 27)) * 0x94D049BB133111EBL;
return z ^ (z >>> 31);]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1793000000036</Id>
					<Name><![CDATA[liberaAsignacionPed]]></Name>
					<X>1333</X><Y>-421</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[ped]]></Name>
						<Type><![CDATA[Pasajero]]></Type>
					</Parameter>
					<Body><![CDATA[// El pasajero empezo a validar (o se reasigna): deja de contar en el molinete que eligio.
if (ped.colaElegidaPed >= 0) {
    asignadosPed[ped.colaElegidaPed]--;
    ped.colaElegidaPed = -1;
}]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1791000000160</Id>
					<Name><![CDATA[registraIngresoPed]]></Name>
					<X>1333</X><Y>-505</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[ped]]></Name>
						<Type><![CDATA[Pasajero]]></Type>
					</Parameter>
					<Body><![CDATA[nGeneradosPed++;
ped.tIngresoSistemaPed = time();
ped.enPicoPed = time() >= inicioPicoPedSeg && time() < finPicoPedSeg;
// El servicio se sortea al ingresar, en orden de llegada y con un generador propio.
ped.servicioAsignadoPed = modoFranjaPed ? tiempoServicioPed() : servicioDemoSeg;
actualizarTransitoPed();]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1791000000086</Id>
					<Name><![CDATA[comienzaServicioPed]]></Name>
					<X>1333</X><Y>-365</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[ped]]></Name>
						<Type><![CDATA[Pasajero]]></Type>
					</Parameter>
					<Body><![CDATA[// Quien empieza a validar sin haber pasado por la cola llega al molinete en este instante
// y su espera es 0. tEntradaColaPed solo vale si el pasajero entro a la cola: si no, conserva
// la hora de entrada al bloque (en el acceso, a ~41 m) y la "espera" seria la caminata.
liberaAsignacionPed(ped);
boolean hizoCola = ped.enColaPed;
if (!hizoCola) nLlegadosMolinetePed++;
if (hizoCola) {
    actualizarAreaColaPed();
    nEsperandoPed--;
    ped.enColaPed = false;
}
double espera = hizoCola ? Math.max(0, time() - ped.tEntradaColaPed) : 0;
sumaEsperaPed += espera;
nEsperasPed++;
esperaMaxPed = Math.max(esperaMaxPed, espera);
esperasPed.add(espera);
if (espera > 30) nMas30Ped++;
if (ped.enPicoPed) esperasPicoPed.add(espera);
ped.tInicioServicioPed = time();
// Transito del Roca: desde que baja del tren hasta que llega a la cola (o al molinete, si no hizo cola). Si la boca
// escaleras del bloque central o el pasillo hacen de embudo, la espera se corre ahi y este tiempo crece.
if (ped.desdeRocaPed) transitosRocaPed.add((hizoCola ? ped.tEntradaColaPed : time()) - ped.tIngresoSistemaPed);
Integer previasMolinete = validacionesPorMolinetePed.get(ped.nombreMolinetePed);
validacionesPorMolinetePed.put(ped.nombreMolinetePed, previasMolinete == null ? 1 : previasMolinete + 1);
int ventana = (int)Math.floor(time() / 900.0);
if (ventana >= 0 && ventana < validacionesPorVentanaPed.length) validacionesPorVentanaPed[ventana]++;
actualizarTransitoPed();]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1791000000161</Id>
					<Name><![CDATA[terminaServicioPed]]></Name>
					<X>1333</X><Y>-337</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[ped]]></Name>
						<Type><![CDATA[Pasajero]]></Type>
					</Parameter>
					<Body><![CDATA[double inicio = Math.min(ped.tInicioServicioPed, horizonteCortePed);
double fin = Math.min(time(), horizonteCortePed);
double ocupado = Math.max(0, fin - inicio);
Double previo = ocupacionPorMolinetePed.get(ped.nombreMolinetePed);
ocupacionPorMolinetePed.put(ped.nombreMolinetePed, (previo == null ? 0 : previo) + ocupado);]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1791000000087</Id>
					<Name><![CDATA[generarTandaPed]]></Name>
					<X>1333</X><Y>-197</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Demo sintetica: tandas regulares instantaneas. La franja usa programarDemandaFranjaPed().
if (arribosCerradosPed || modoFranjaPed) return;
nTandasPed++;
if (tamanoTandaDemo > 0) {
    tiempoUltimaTandaPed = time();
    nInyectadosPed += tamanoTandaDemo;
    nDesdeRocaPed += tamanoTandaDemo;
    pedSource.inject(tamanoTandaDemo);
}
if (nTandasPed < cantidadTandasDemo) proximaTandaPed.restart(intervaloTandaDemoSeg);
else arribosCerradosPed = true;]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1791000000088</Id>
					<Name><![CDATA[salePed]]></Name>
					<X>1333</X><Y>-253</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[nProcesadosPed++;
if (drenadoPed()) {
    actualizarAreaColaPed();
    ultimaDisipacionPed = time() - tiempoUltimaTandaPed;
    if (time() >= horizonteCortePed) emitirResultadoPed();
}]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
