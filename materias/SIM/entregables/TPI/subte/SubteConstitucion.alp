            <PublicFlag>true</PublicFlag>
            <PresentationFlag>true</PresentationFlag>
            <ShowLabel>true</ShowLabel>
            <Label><X>10</X><Y>0</Y></Label>
            <Body>switch (escenario) {
    case 0: return "Base: 20 molinetes";
    case 1: return "Capacidad: 28 molinetes";
    case 2: return "Desvio parcial a Plaza";
    case 3: return "Validacion EMV/QR";
    default: return "Escenario invalido";
}</Body>
          </Function>
          <Function AccessType="public" StaticFunction="false">
            <ReturnModificator>RETURNS_VALUE</ReturnModificator>
            <ReturnType>String</ReturnType>
            <Id>1790000000145</Id>
            <Name>horaSimulada</Name>
            <X>980</X>
            <Y>465</Y>
            <PublicFlag>true</PublicFlag>
            <PresentationFlag>true</PresentationFlag>
            <ShowLabel>true</ShowLabel>
            <Label><X>10</X><Y>0</Y></Label>
            <Body>int s = (int)Math.max(0, Math.min(time(), horizonteSeg));
int total = 7*3600 + s;
return String.format("%02d:%02d:%02d", total/3600, (total%3600)/60, total%60);</Body>
          </Function>
          <Function AccessType="public" StaticFunction="false">
            <ReturnModificator>RETURNS_VALUE</ReturnModificator>
            <ReturnType>String</ReturnType>
            <Id>1790000000146</Id>
            <Name>estadoModelo</Name>
            <X>980</X>
            <Y>490</Y>
            <PublicFlag>true</PublicFlag>
            <PresentationFlag>true</PresentationFlag>
            <ShowLabel>true</ShowLabel>
            <Label><X>10</X><Y>0</Y></Label>
            <Body>if (finalizado) return "FINALIZADO";
if (cerrado) return "DRENAJE DESPUES DE 09:30";
if (time() &gt;= 4500 &amp;&amp; time() &lt; 6300) return "VENTANA PICO";
return "SIMULANDO";</Body>
          </Function>
          <Function AccessType="public" StaticFunction="false">
            <ReturnModificator>RETURNS_VALUE</ReturnModificator>
            <ReturnType>double</ReturnType>
            <Id>1790000000147</Id>
            <Name>esperaMediaActual</Name>
            <X>980</X>
            <Y>515</Y>
            <PublicFlag>true</PublicFlag>
            <PresentationFlag>true</PresentationFlag>
            <ShowLabel>true</ShowLabel>
            <Label><X>10</X><Y>0</Y></Label>
            <Body>return esperas.isEmpty() ? 0 : sumaEspera/esperas.size();</Body>
          </Function>
          <Function AccessType="public" StaticFunction="false">
            <ReturnModificator>RETURNS_VALUE</ReturnModificator>
            <ReturnType>double</ReturnType>
            <Id>1790000000148</Id>
            <Name>utilizacionActual</Name>
            <X>980</X>
            <Y>540</Y>
            <PublicFlag>true</PublicFlag>
            <PresentationFlag>true</PresentationFlag>
            <ShowLabel>true</ShowLabel>
            <Label><X>10</X><Y>0</Y></Label>
            <Body>double hasta = Math.min(time(), horizonteSeg);
if (hasta &lt;= 0) return 0;
double acumulada = areaOcupados + nOcupados*Math.max(0, hasta-tArea);
return acumulada/(hasta*capacidadMolinetes());</Body>
          </Function>
          <Function AccessType="public" StaticFunction="false">
            <ReturnModificator>RETURNS_VALUE</ReturnModificator>
            <ReturnType>double</ReturnType>
            <Id>1790000000096</Id>
            <Name>dispersionUtilizacion</Name>
            <X>980</X>
            <Y>565</Y>
            <PublicFlag>true</PublicFlag>
            <PresentationFlag>true</PresentationFlag>
            <ShowLabel>true</ShowLabel>
            <Label>
              <X>10</X>
              <Y>0</Y>
            </Label>
            <Body>double suma=0, suma2=0;
for (double ocupado : ocupacionPorUnidad.values()) {
    double u=ocupado/horizonteSeg; suma+=u; suma2+=u*u;
}
int c=capacidadMolinetes();
return Math.sqrt(Math.max(0, suma2/c-(suma/c)*(suma/c)));</Body>
          </Function>
          <Function AccessType="public" StaticFunction="false">
            <ReturnModificator>RETURNS_VALUE</ReturnModificator>
            <ReturnType>String</ReturnType>
            <Id>1790000000097</Id>
            <Name>resumen</Name>
            <X>980</X>
            <Y>590</Y>
            <PublicFlag>true</PublicFlag>
            <PresentationFlag>true</PresentationFlag>
            <ShowLabel>true</ShowLabel>
            <Label>
              <X>10</X>
              <Y>0</Y>
            </Label>
            <Body>int n = esperas.size();
double d = 0; for (double v : disipaciones) d += v;
return (modoDemo ? "DEMO; " : "SIN VALIDAR; ") + "E" + escenario
 + "; generados=" + nGenerados + "; desviadosPlaza=" + nDesviados
 + "; procesadosFranja=" + nProcesadosFranja + "; procesadosConDrenaje=" + nProcesados
 + "; pendientes0930=" + pendientesAlCierre + "; cola0930=" + colaAlCierre
 + "; esperaMediaSeg=" + (n == 0 ? Double.NaN : sumaEspera/n)
 + "; p90Seg=" + percentil90() + "; propMas30=" + (n == 0 ? Double.NaN : (double)nMas30/n)
 + "; nPico0815a0845=" + nPico
 + "; esperaMediaPicoSeg=" + (nPico == 0 ? Double.NaN : sumaEsperaPico/nPico)
 + "; p90PicoSeg=" + percentil90Pico()
 + "; propMas30Pico=" + (nPico == 0 ? Double.NaN : (double)nMas30Pico/nPico)
 + "; Lq=" + areaCola/horizonteSeg + "; qMax=" + qMax
 + "; utilizacion=" + areaOcupados/(horizonteSeg*capacidadMolinetes())
 + "; disipacionMediaSeg=" + (disipaciones.isEmpty() ? Double.NaN : d/disipaciones.size())
 + "; tandasDisipadas=" + disipaciones.size()
 + "; desvioUtilizacionMolinetes=" + dispersionUtilizacion();</Body>
          </Function>
