		<ActiveObjectClass>
			<Id>1791000000001</Id>
			<Name><![CDATA[MainPeatonal]]></Name>
			<StartupCode><![CDATA[inicializarPed();
traceln(modoFranjaPed ? (pruebaSinteticaPed ? "FRANJA PEATONAL 07:00-09:30 - VALORES DE PRUEBA - PLANO HIPOTETICO" : "FRANJA PEATONAL 07:00-09:30 - RANGOS CON FUENTE (PLAN 5) - PLANO HIPOTETICO") : "DEMO PEATONAL - GEOMETRIA Y DATOS SINTETICOS");
configurarMolinetesPed();
if (modoFranjaPed) programarDemandaFranjaPed(); else proximaTandaPed.restart(0);
cierreMetricasPed.restart(horizonteCortePed);
progresoPed.restart(intervaloProgresoPed());]]></StartupCode>
