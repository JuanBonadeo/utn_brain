					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[int hall = hallPed();
if (hall > hallMaxPed) {
    hallMaxPed = hall;
    tHallMaxPed = time();
}
pagaMaxPed = Math.max(pagaMaxPed, pagaPed());]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1793000000013</Id>
					<Name><![CDATA[segundosRealesPed]]></Name>
					<X>2000</X><Y>975</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Tiempo de pared desde la inicializacion: mide el costo de computo de la corrida.
return inicioRealMsPed <= 0 ? 0 : (System.currentTimeMillis() - inicioRealMsPed) / 1000.0;]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
