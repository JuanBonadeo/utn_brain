					<Body><![CDATA[if (esperasPicoPed.isEmpty()) return 0;
java.util.ArrayList<Double> ordenadas = new java.util.ArrayList<Double>(esperasPicoPed);
java.util.Collections.sort(ordenadas);
int posicion = Math.max(0, (int)Math.ceil(0.9 * ordenadas.size()) - 1);
return ordenadas.get(posicion);]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1791000000166</Id>
					<Name><![CDATA[utilizacionMediaPed]]></Name>
					<X>1750</X><Y>235</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (horizonteCortePed <= 0 || molinetesOperativosPed <= 0) return 0;
double ocupacion = 0;
for (double valor : ocupacionPorMolinetePed.values()) ocupacion += valor;
return ocupacion/(horizonteCortePed*molinetesOperativosPed);]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1791000000167</Id>
					<Name><![CDATA[dispersionUtilizacionPed]]></Name>
					<X>1750</X><Y>270</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (horizonteCortePed <= 0 || molinetesOperativosPed <= 0) return 0;
double media = utilizacionMediaPed();
double suma = 0;
for (int i=1; i<=molinetesOperativosPed; i++) {
    String nombre = String.format("molinetePed%02d", i);
    double u = ocupacionPorMolinetePed.containsKey(nombre) ? ocupacionPorMolinetePed.get(nombre)/horizonteCortePed : 0;
    suma += (u-media)*(u-media);
}
return Math.sqrt(suma/molinetesOperativosPed);]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1791000000168</Id>
					<Name><![CDATA[utilizacionPorMolinetePed]]></Name>
					<X>1750</X><Y>305</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[java.util.ArrayList<String> partes = new java.util.ArrayList<String>();
for (int i=1; i<=molinetesOperativosPed; i++) {
    String nombre = String.format("molinetePed%02d", i);
    double ocupado = ocupacionPorMolinetePed.containsKey(nombre) ? ocupacionPorMolinetePed.get(nombre) : 0;
    partes.add(nombre + "=" + String.format(java.util.Locale.US, "%.3f", ocupado/horizonteCortePed));
}
return String.join(",", partes);]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1791000000090</Id>
					<Name><![CDATA[lqPed]]></Name>
					<X>1500</X><Y>270</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double fin = Math.min(time(), horizonteCortePed);
if (fin <= 0) return 0;
double acumulada = areaColaPed + nEsperandoPed*Math.max(0, fin-tAreaColaPed);
return acumulada/fin;]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1791000000091</Id>
					<Name><![CDATA[resumenPeatonal]]></Name>
					<X>1500</X><Y>305</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return (modoFranjaPed ? (pruebaSinteticaPed ? "FRANJA PEATONAL - PRUEBA SINTETICA, NO ES RESULTADO" : "FRANJA PEATONAL - ENTRADAS PENDIENTES DE CALIBRACION - PLANO HIPOTETICO") : "DEMO PEATONAL SINTETICA")
 + "; corteSeg=" + horizonteCortePed + "; trenes=" + nTrenesPed + "; tandas=" + nTandasPed + "; inyectados=" + nInyectadosPed
 + "; desdeRoca=" + nDesdeRocaPed + "; desdeCalle=" + nDesdeCallePed
 + "; generados=" + nGeneradosPed + "; procesados=" + nProcesadosPed
 + "; molinetesOperativos=" + molinetesOperativosPed
 + "; esperaMediaSeg=" + esperaMediaPed() + "; p90Seg=" + percentil90Ped()
 + "; proporcionMas30=" + proporcionMas30Ped() + "; esperaMaxSeg=" + esperaMaxPed
 + "; qMax=" + qMaxPed + "; Lq=" + lqPed()
 + "; utilizacionMedia=" + utilizacionMediaPed() + "; dispersionUtilizacion=" + dispersionUtilizacionPed()
 + "; cohortePicoN=" + esperasPicoPed.size() + "; cohortePicoEsperaMediaSeg=" + esperaMediaPicoPed()
 + "; cohortePicoP90Seg=" + p90PicoPed() + "; disipacionUltimoIngresoSeg=" + ultimaDisipacionPed
 + (modoFranjaPed ? "; caudalPorVentana=" + caudalPorVentanaPed() : "")
 + "; enTransitoHallMax=" + hallMaxPed + "; tHallMaxSeg=" + tHallMaxPed + "; hallAlCorte=" + hallAlCortePed
 + "; zonaPagaMax=" + pagaMaxPed + "; segundosReales=" + String.format(java.util.Locale.US, "%.1f", segundosRealesPed())
 + "; utilizacionPorMolinete=" + utilizacionPorMolinetePed();]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1791000000181</Id>
					<Name><![CDATA[filaResultadoPed]]></Name>
					<X>1750</X><Y>340</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[String escenarioPed = molinetesOperativosPed == 20 ? "E0" : (molinetesOperativosPed == 22 ? "E1"
    : (molinetesOperativosPed == 28 ? "E1B" : "M" + molinetesOperativosPed));
return String.join(";",
    escenarioPed,
    Long.toString(semillaPed),
    Integer.toString(nGeneradosPed),
    "0",
    Integer.toString(nProcesadosHorizontePed),
    Integer.toString(nProcesadosPed),
    String.format(java.util.Locale.US, "%.6f", esperaMediaPed()),
    String.format(java.util.Locale.US, "%.6f", percentil90Ped()),
    String.format(java.util.Locale.US, "%.6f", proporcionMas30Ped()),
    String.format(java.util.Locale.US, "%.6f", lqPed()),
    Integer.toString(qMaxPed),
    String.format(java.util.Locale.US, "%.6f", ultimaDisipacionPed),
    String.format(java.util.Locale.US, "%.6f", utilizacionMediaPed()),
    String.format(java.util.Locale.US, "%.6f", dispersionUtilizacionPed()),
    Integer.toString(esperasPicoPed.size()),
    String.format(java.util.Locale.US, "%.6f", esperaMediaPicoPed()),
    String.format(java.util.Locale.US, "%.6f", p90PicoPed()));]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1791000000184</Id>
					<Name><![CDATA[emitirResultadoPed]]></Name>
					<X>1750</X><Y>375</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (resultadoEmitidoPed) return;
if (nGeneradosPed != nInyectadosPed || nProcesadosPed != nInyectadosPed)
    throw new IllegalStateException("Conservacion peatonal violada: inyectados=" + nInyectadosPed
        + ", generados=" + nGeneradosPed + ", procesados=" + nProcesadosPed);
resultadoEmitidoPed = true;
String linea = prefijoResultadoPed() + ";" + filaResultadoPed();
traceln(resumenPeatonal());
traceln(linea);
escribirFilaPed(linea);
if (modoFranjaPed) getEngine().finish();]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1791000000102</Id>
					<Name><![CDATA[configurarMolinetesPed]]></Name>
					<X>1500</X><Y>340</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// E0 = 20 (disponibilidad observada), E1 = 22 (todos los IDs del vestibulo Principal en SBASE 2026),
// 28 = ampliacion hipotetica (E1-b). Los puestos 23-28 no existen en el vestibulo real.
if (molinetesOperativosPed < 20 || molinetesOperativosPed > 28)
    throw new IllegalArgumentException("La capa peatonal admite entre 20 y 28 molinetes (E0 = 20, E1 = 22, ampliacion hipotetica = 28)");
molinetesPeatonales.setServiceSuspended(molinetePed21, molinetesOperativosPed < 21);
molinetesPeatonales.setServiceSuspended(molinetePed22, molinetesOperativosPed < 22);
molinetesPeatonales.setServiceSuspended(molinetePed23, molinetesOperativosPed < 23);
molinetesPeatonales.setServiceSuspended(molinetePed24, molinetesOperativosPed < 24);
molinetesPeatonales.setServiceSuspended(molinetePed25, molinetesOperativosPed < 25);
molinetesPeatonales.setServiceSuspended(molinetePed26, molinetesOperativosPed < 26);
molinetesPeatonales.setServiceSuspended(molinetePed27, molinetesOperativosPed < 27);
molinetesPeatonales.setServiceSuspended(molinetePed28, molinetesOperativosPed < 28);]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1792000000022</Id>
					<Name><![CDATA[inicializarPed]]></Name>
					<X>2000</X><Y>60</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (horizonteMetricasPedSeg <= 0) throw new IllegalArgumentException("horizonteMetricasPedSeg debe ser positivo");
if (inicioPicoPedSeg < 0 || finPicoPedSeg <= inicioPicoPedSeg) throw new IllegalArgumentException("Cohorte pico invalida");
if (modoFranjaPed) {
    if (proporcionRocaPed < 0 || proporcionRocaPed > 1 || demoraAccesoRocaSeg < 0 || duracionDescargaSeg <= 0 || servicioPedSeg <= 0)
        throw new IllegalArgumentException("Franja peatonal PENDIENTE DE CALIBRACION: completar proporcionRocaPed, "
            + "demoraAccesoRocaSeg, duracionDescargaSeg y servicioPedSeg con mediciones o rangos aprobados");
    boolean triangular = servicioMinPedSeg >= 0 || servicioMaxPedSeg >= 0;
    if (triangular && !(servicioMinPedSeg > 0 && servicioMinPedSeg <= servicioPedSeg && servicioPedSeg <= servicioMaxPedSeg))
        throw new IllegalArgumentException("Servicio triangular: requiere 0 < servicioMinPedSeg <= servicioPedSeg <= servicioMaxPedSeg");
    if (factorDemandaPed <= 0) throw new IllegalArgumentException("factorDemandaPed debe ser positivo");
    if (horizonteArribosPedSeg <= 0 || horizonteArribosPedSeg > 9000)
        throw new IllegalArgumentException("horizonteArribosPedSeg debe estar en (0, 9000]");
    if (perfilPed15min == null || perfilPed15min.length != 10)
        throw new IllegalArgumentException("perfilPed15min: diez ventanas de 15 minutos");
    for (double v : perfilPed15min)
        if (!Double.isFinite(v) || v < 0) throw new IllegalArgumentException("perfilPed15min invalido");
    if (llegadasRocaSeg == null) throw new IllegalArgumentException("llegadasRocaSeg: falta el horario del Roca");
    for (double t : llegadasRocaSeg)
        if (!Double.isFinite(t)) throw new IllegalArgumentException("llegadasRocaSeg invalido");
    horizonteCortePed = horizonteArribosPedSeg;
} else {
    if (tamanoTandaDemo < 0 || intervaloTandaDemoSeg <= 0 || cantidadTandasDemo <= 0 || servicioDemoSeg <= 0)
        throw new IllegalArgumentException("Parametros de la demo peatonal invalidos");
    horizonteCortePed = horizonteMetricasPedSeg;
}
// La semilla efectiva es semillaPed. La calle y el servicio usan generadores propios para que E0 y E1
// reciban exactamente los mismos arribos y tiempos de validacion (numeros aleatorios comunes).
getDefaultRandomGenerator().setSeed(semillaPed);
rngCallePed.setSeed(semillaPed * 1000003L + 11);
rngServicioPed.setSeed(semillaPed * 1000003L + 29);
inicioRealMsPed = System.currentTimeMillis();
inicializadoPed = true;]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1792000000024</Id>
					<Name><![CDATA[drenadoPed]]></Name>
					<X>2000</X><Y>130</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return arribosCerradosPed && nProcesadosPed == nInyectadosPed;]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1792000000025</Id>
					<Name><![CDATA[prefijoResultadoPed]]></Name>
					<X>2000</X><Y>165</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
