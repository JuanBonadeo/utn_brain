            <ReturnType>double</ReturnType>
            <Id>1790000000084</Id>
            <Name>intervaloSeg</Name>
            <X>980</X>
            <Y>115</Y>
            <PublicFlag>true</PublicFlag>
            <PresentationFlag>true</PresentationFlag>
            <ShowLabel>true</ShowLabel>
            <Label>
              <X>10</X>
              <Y>0</Y>
            </Label>
            <Body>return modoDemo ? 150.0 : intervaloTandaSeg;</Body>
          </Function>
          <Function AccessType="public" StaticFunction="false">
            <ReturnModificator>RETURNS_VALUE</ReturnModificator>
            <ReturnType>int</ReturnType>
            <Id>1790000000085</Id>
            <Name>tamanoActual</Name>
            <X>980</X>
            <Y>140</Y>
            <PublicFlag>true</PublicFlag>
            <PresentationFlag>true</PresentationFlag>
            <ShowLabel>true</ShowLabel>
            <Label>
              <X>10</X>
              <Y>0</Y>
            </Label>
            <Body>double base = modoDemo ? 300 : tamanoTanda;
int w = Math.min(9, (int)(time()/900));
double factor = usarPerfilSBASE ? perfil15min[w]/1748.2 : 1.0;
return Math.max(0, (int)Math.round(base*factor));</Body>
          </Function>
          <Function AccessType="public" StaticFunction="false">
            <ReturnModificator>VOID</ReturnModificator>
            <ReturnType>void</ReturnType>
            <Id>1790000000086</Id>
            <Name>inicializar</Name>
            <X>980</X>
            <Y>165</Y>
            <PublicFlag>true</PublicFlag>
            <PresentationFlag>true</PresentationFlag>
            <ShowLabel>true</ShowLabel>
            <Label>
              <X>10</X>
              <Y>0</Y>
            </Label>
            <Body>if (escenario &lt; 0 || escenario &gt; 3 || molinetesBase &lt; 1 || molinetesE1 &lt; 1)
    throw new IllegalArgumentException("Escenario o cantidad de molinetes invalida");
if (!Double.isFinite(horizonteSeg) || horizonteSeg &lt;= 0 || horizonteSeg &gt; 9000 ||
    !Double.isFinite(primeraTandaSeg) || primeraTandaSeg &lt; 0 || primeraTandaSeg &gt;= horizonteSeg ||
    !Double.isFinite(fraccionDesvioE2) || fraccionDesvioE2 &lt; 0 || fraccionDesvioE2 &gt; 1)
    throw new IllegalArgumentException("Revisar horizonte, primera tanda y fraccion de desvio");
if (!modoDemo &amp;&amp; (tamanoTanda &lt;= 0 || !Double.isFinite(intervaloTandaSeg) || intervaloTandaSeg &lt;= 0 ||
    !Double.isFinite(servicioSUBESeg) || servicioSUBESeg &lt;= 0 ||
    (escenario == 3 &amp;&amp; (!Double.isFinite(servicioEMVSeg) || servicioEMVSeg &lt;= 0))))
    throw new IllegalArgumentException("Completar medicion: tamanoTanda, intervaloTandaSeg, servicioSUBESeg y servicioEMVSeg para E3");
if (perfil15min == null || perfil15min.length != 10) throw new IllegalArgumentException("Perfil: diez ventanas");
for (double v : perfil15min) if (!Double.isFinite(v) || v &lt; 0) throw new IllegalArgumentException("Perfil invalido");
rngDesvio = new java.util.Random(semilla);
iniciado = true;
traceln((modoDemo ? "DEMO SINTETICA - NO CALIBRADA" : "PARAMETROS CARGADOS - PENDIENTE VALIDACION") + " E" + escenario);
proximaTanda.restart(primeraTandaSeg);
cierreFranja.restart(horizonteSeg);</Body>
          </Function>
          <Function AccessType="public" StaticFunction="false">
            <ReturnModificator>VOID</ReturnModificator>
            <ReturnType>void</ReturnType>
            <Id>1790000000087</Id>
            <Name>generarTanda</Name>
            <X>980</X>
            <Y>190</Y>
            <PublicFlag>true</PublicFlag>
            <PresentationFlag>true</PresentationFlag>
            <ShowLabel>true</ShowLabel>
            <Label>
              <X>10</X>
              <Y>0</Y>
            </Label>
            <Body>if (time() &gt;= horizonteSeg) return;
int total = tamanoActual();
int principal = 0;
for (int i=0; i&lt;total; i++) {
    double u = rngDesvio.nextDouble(); // Se consume en todos los escenarios.
    if (escenario == 2 &amp;&amp; u &lt; fraccionDesvioE2) nDesviados++;
    else principal++;
}
nGenerados += total;
nPrincipal += principal;
if (principal &gt; 0) {
    tandasAbiertas.add(time());
    source.inject(principal);
}
observarCola.restart(0.000001);
double siguiente = time() + intervaloSeg();
if (siguiente &lt; horizonteSeg) proximaTanda.restart(intervaloSeg());</Body>
          </Function>
          <Function AccessType="public" StaticFunction="false">
            <ReturnModificator>VOID</ReturnModificator>
            <ReturnType>void</ReturnType>
            <Id>1790000000088</Id>
            <Name>actualizarAreas</Name>
            <X>980</X>
            <Y>215</Y>
            <PublicFlag>true</PublicFlag>
            <PresentationFlag>true</PresentationFlag>
            <ShowLabel>true</ShowLabel>
            <Label>
              <X>10</X>
              <Y>0</Y>
            </Label>
            <Body>double hasta = Math.min(time(), horizonteSeg);
double dt = Math.max(0, hasta - tArea);
areaCola += nEsperando * dt;
areaOcupados += nOcupados * dt;
tArea = hasta;</Body>
          </Function>
          <Function AccessType="public" StaticFunction="false">
            <ReturnModificator>VOID</ReturnModificator>
            <ReturnType>void</ReturnType>
            <Id>1790000000089</Id>
            <Name>entraCola</Name>
            <X>980</X>
            <Y>240</Y>
            <PublicFlag>true</PublicFlag>
            <PresentationFlag>true</PresentationFlag>
            <ShowLabel>true</ShowLabel>
            <Label>
              <X>10</X>
              <Y>0</Y>
            </Label>
            <Parameter>
              <Name>agent</Name>
              <Type>Agent</Type>
            </Parameter>
            <Body>actualizarAreas();
llegadas.put(agent, time());
nEsperando++;
ultimaCola = time();
// Excluir transferencias instantaneas hacia molinetes libres del maximo fisico.
qMax = Math.max(qMax, Math.max(0, nEsperando - Math.max(0, capacidadMolinetes()-nOcupados)));
observarCola.restart(0.000001);</Body>
          </Function>
          <Function AccessType="public" StaticFunction="false">
            <ReturnModificator>VOID</ReturnModificator>
            <ReturnType>void</ReturnType>
            <Id>1790000000090</Id>
            <Name>iniciaServicio</Name>
            <X>980</X>
            <Y>265</Y>
            <PublicFlag>true</PublicFlag>
            <PresentationFlag>true</PresentationFlag>
            <ShowLabel>true</ShowLabel>
            <Label>
              <X>10</X>
              <Y>0</Y>
            </Label>
            <Parameter>
              <Name>agent</Name>
              <Type>Agent</Type>
            </Parameter>
            <Parameter>
              <Name>unit</Name>
              <Type>Agent</Type>
            </Parameter>
            <Body>actualizarAreas();
Double llegada = llegadas.remove(agent);
if (llegada == null) throw new IllegalStateException("Pasajero sin instante de llegada");
double w = time() - llegada;
esperas.add(w); sumaEspera += w;
if (w &gt; 30) nMas30++;
if (llegada &gt;= 4500 &amp;&amp; llegada &lt; 6300) {
    esperasPico.add(w); sumaEsperaPico += w; nPico++;
    if (w &gt; 30) nMas30Pico++;
}
nEsperando--; nOcupados++;
ultimaCola = time();
inicioPorUnidad.put(unit, time());
if (!ocupacionPorUnidad.containsKey(unit)) ocupacionPorUnidad.put(unit, 0.0);
observarCola.restart(0.000001);</Body>
          </Function>
          <Function AccessType="public" StaticFunction="false">
            <ReturnModificator>VOID</ReturnModificator>
            <ReturnType>void</ReturnType>
            <Id>1790000000091</Id>
            <Name>liberaMolinete</Name>
            <X>980</X>
            <Y>290</Y>
            <PublicFlag>true</PublicFlag>
            <PresentationFlag>true</PresentationFlag>
            <ShowLabel>true</ShowLabel>
            <Label>
              <X>10</X>
              <Y>0</Y>
            </Label>
            <Parameter>
              <Name>unit</Name>
              <Type>Agent</Type>
            </Parameter>
            <Body>actualizarAreas();
nOcupados--;
double inicio = inicioPorUnidad.remove(unit);
double duracion = Math.max(0, Math.min(time(), horizonteSeg)-Math.min(inicio, horizonteSeg));
ocupacionPorUnidad.put(unit, ocupacionPorUnidad.get(unit)+duracion);</Body>
          </Function>
          <Function AccessType="public" StaticFunction="false">
            <ReturnModificator>VOID</ReturnModificator>
            <ReturnType>void</ReturnType>
            <Id>1790000000092</Id>
            <Name>salePasajero</Name>
            <X>980</X>
            <Y>315</Y>
            <PublicFlag>true</PublicFlag>
            <PresentationFlag>true</PresentationFlag>
            <ShowLabel>true</ShowLabel>
            <Label>
              <X>10</X>
              <Y>0</Y>
            </Label>
            <Body>nProcesados++;
if (time() &lt; horizonteSeg) nProcesadosFranja++;
observarCola.restart(0.000001);</Body>
          </Function>
          <Function AccessType="public" StaticFunction="false">
            <ReturnModificator>VOID</ReturnModificator>
            <ReturnType>void</ReturnType>
            <Id>1790000000093</Id>
            <Name>observar</Name>
            <X>980</X>
            <Y>340</Y>
            <PublicFlag>true</PublicFlag>
            <PresentationFlag>true</PresentationFlag>
            <ShowLabel>true</ShowLabel>
            <Label>
              <X>10</X>
              <Y>0</Y>
            </Label>
            <Body>if (nEsperando == 0 &amp;&amp; !tandasAbiertas.isEmpty()) {
    for (double t : tandasAbiertas) disipaciones.add(Math.max(0, ultimaCola-t));
    tandasAbiertas.clear();
}
if (cerrado &amp;&amp; nProcesados == nPrincipal &amp;&amp; !finalizado) {
    finalizado = true;
    if (nGenerados != nDesviados + nProcesados) throw new IllegalStateException("Balance de pasajeros");
    traceln(resumen());
    getEngine().finish();
}</Body>
          </Function>
          <Function AccessType="public" StaticFunction="false">
            <ReturnModificator>VOID</ReturnModificator>
            <ReturnType>void</ReturnType>
            <Id>1790000000094</Id>
            <Name>cerrarFranja</Name>
            <X>980</X>
            <Y>365</Y>
            <PublicFlag>true</PublicFlag>
            <PresentationFlag>true</PresentationFlag>
            <ShowLabel>true</ShowLabel>
            <Label>
              <X>10</X>
              <Y>0</Y>
            </Label>
            <Body>actualizarAreas();
cerrado = true;
pendientesAlCierre = nPrincipal - nProcesadosFranja;
colaAlCierre = nEsperando;
observarCola.restart(0.000001);</Body>
          </Function>
          <Function AccessType="public" StaticFunction="false">
            <ReturnModificator>RETURNS_VALUE</ReturnModificator>
            <ReturnType>double</ReturnType>
            <Id>1790000000095</Id>
            <Name>percentil90</Name>
            <X>980</X>
            <Y>390</Y>
            <PublicFlag>true</PublicFlag>
            <PresentationFlag>true</PresentationFlag>
            <ShowLabel>true</ShowLabel>
            <Label>
              <X>10</X>
              <Y>0</Y>
            </Label>
            <Body>if (esperas.isEmpty()) return Double.NaN;
java.util.ArrayList&lt;Double&gt; ordenadas = new java.util.ArrayList&lt;Double&gt;(esperas);
java.util.Collections.sort(ordenadas);
return ordenadas.get((int)Math.ceil(0.9*ordenadas.size())-1);</Body>
          </Function>
