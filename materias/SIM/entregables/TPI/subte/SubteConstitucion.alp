					</Parameter>
					<Body><![CDATA[nLlegadosMolinetePed++;
actualizarAreaColaPed();
ped.enColaPed = true;
nEsperandoPed++;
qMaxPed = Math.max(qMaxPed, nEsperandoPed);]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1791000000160</Id>
					<Name><![CDATA[registraIngresoPed]]></Name>
					<X>1500</X><Y>112</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[ped]]></Name>
						<Type><![CDATA[Pasajero]]></Type>
					</Parameter>
					<Body><![CDATA[nGeneradosPed++;
ped.tIngresoSistemaPed = time();
ped.enPicoPed = time() >= inicioPicoPedSeg && time() < finPicoPedSeg;
// El servicio se sortea al ingresar, en orden de llegada y con un generador propio.
ped.servicioAsignadoPed = modoFranjaPed ? tiempoServicioPed() : servicioDemoSeg;
actualizarTransitoPed();]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1791000000086</Id>
					<Name><![CDATA[comienzaServicioPed]]></Name>
					<X>1500</X><Y>130</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[ped]]></Name>
						<Type><![CDATA[Pasajero]]></Type>
					</Parameter>
					<Body><![CDATA[// Quien empieza a validar sin haber pasado por la cola llega al molinete en este instante.
if (!ped.enColaPed) nLlegadosMolinetePed++;
if (ped.enColaPed) {
    actualizarAreaColaPed();
    nEsperandoPed--;
    ped.enColaPed = false;
}
double espera = Math.max(0, time() - ped.tEntradaColaPed);
sumaEsperaPed += espera;
nEsperasPed++;
esperaMaxPed = Math.max(esperaMaxPed, espera);
esperasPed.add(espera);
if (espera > 30) nMas30Ped++;
if (ped.enPicoPed) esperasPicoPed.add(espera);
ped.tInicioServicioPed = time();
int ventana = (int)Math.floor(time() / 900.0);
if (ventana >= 0 && ventana < validacionesPorVentanaPed.length) validacionesPorVentanaPed[ventana]++;
actualizarTransitoPed();]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1791000000161</Id>
					<Name><![CDATA[terminaServicioPed]]></Name>
					<X>1500</X><Y>147</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[ped]]></Name>
						<Type><![CDATA[Pasajero]]></Type>
					</Parameter>
					<Body><![CDATA[double inicio = Math.min(ped.tInicioServicioPed, horizonteCortePed);
double fin = Math.min(time(), horizonteCortePed);
double ocupado = Math.max(0, fin - inicio);
Double previo = ocupacionPorMolinetePed.get(ped.nombreMolinetePed);
ocupacionPorMolinetePed.put(ped.nombreMolinetePed, (previo == null ? 0 : previo) + ocupado);]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1791000000087</Id>
					<Name><![CDATA[generarTandaPed]]></Name>
					<X>1500</X><Y>165</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Demo sintetica: tandas regulares instantaneas. La franja usa programarDemandaFranjaPed().
if (arribosCerradosPed || modoFranjaPed) return;
nTandasPed++;
if (tamanoTandaDemo > 0) {
    tiempoUltimaTandaPed = time();
    nInyectadosPed += tamanoTandaDemo;
    nDesdeRocaPed += tamanoTandaDemo;
    pedSource.inject(tamanoTandaDemo);
}
if (nTandasPed < cantidadTandasDemo) proximaTandaPed.restart(intervaloTandaDemoSeg);
else arribosCerradosPed = true;]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1791000000088</Id>
					<Name><![CDATA[salePed]]></Name>
					<X>1500</X><Y>200</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[nProcesadosPed++;
if (drenadoPed()) {
    actualizarAreaColaPed();
    ultimaDisipacionPed = time() - tiempoUltimaTandaPed;
    if (time() >= horizonteCortePed) emitirResultadoPed();
}]]></Body>
				</Function>
