					<X>-1077</X><Y>-598</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return String.join(";",
    escenarioPed(),
    Long.toString(semillaPed),
    Integer.toString(nGeneradosPed),
    "0",
    Integer.toString(nProcesadosHorizontePed),
    Integer.toString(nProcesadosPed),
    String.format(java.util.Locale.US, "%.6f", esperaMediaPed()),
    String.format(java.util.Locale.US, "%.6f", percentil90Ped()),
    String.format(java.util.Locale.US, "%.6f", proporcionMas30Ped()),
    String.format(java.util.Locale.US, "%.6f", lqPed()),
    Integer.toString(qMaxPed),
    String.format(java.util.Locale.US, "%.6f", ultimaDisipacionPed),
    String.format(java.util.Locale.US, "%.6f", utilizacionMediaPed()),
    String.format(java.util.Locale.US, "%.6f", dispersionUtilizacionPed()),
    Integer.toString(esperasPicoPed.size()),
    String.format(java.util.Locale.US, "%.6f", esperaMediaPicoPed()),
    String.format(java.util.Locale.US, "%.6f", p90PicoPed()),
    Integer.toString(diaEfectivoPed),
    String.format(java.util.Locale.US, "%.6f", p90TransitoRocaPed()),
    String.format(java.util.Locale.US, "%.6f", cvValidacionesMolinetePed()));]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1791000000184</Id>
					<Name><![CDATA[emitirResultadoPed]]></Name>
					<X>-1077</X><Y>-542</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (resultadoEmitidoPed) return;
if (nGeneradosPed != nInyectadosPed || nProcesadosPed != nInyectadosPed)
    throw new IllegalStateException("Conservacion peatonal violada: inyectados=" + nInyectadosPed
        + ", generados=" + nGeneradosPed + ", procesados=" + nProcesadosPed);
resultadoEmitidoPed = true;
String linea = prefijoResultadoPed() + ";" + filaResultadoPed();
traceln(resumenPeatonal());
traceln(linea);
escribirFilaPed(linea);
if (modoFranjaPed && archivoSalidaPed != null && !archivoSalidaPed.trim().isEmpty()) {
    String ventanas = "VENTANAS_PEATONAL;" + filaVentanasPed();
    traceln(ventanas);
    escribirLineaPed(archivoSalidaPed.replaceFirst("(\\.csv)?$", "_ventanas.csv"), ventanas);
}
if (modoFranjaPed) getEngine().finish();]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1791000000102</Id>
					<Name><![CDATA[configurarMolinetesPed]]></Name>
					<X>463</X><Y>-267</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// E0 = 20 (disponibilidad observada), E1 = 22 (todos los IDs del vestibulo Principal en SBASE 2026),
// 28 = ampliacion hipotetica (E1-b). Los puestos 23-28 no existen en el vestibulo real.
if (molinetesOperativosPed < 20 || molinetesOperativosPed > 28)
    throw new IllegalArgumentException("La capa peatonal admite entre 20 y 28 molinetes (E0 = 20, E1 = 22, ampliacion hipotetica = 28)");
molinetesPeatonales.setServiceSuspended(molinetePed21, molinetesOperativosPed < 21);
molinetesPeatonales.setServiceSuspended(molinetePed22, molinetesOperativosPed < 22);
molinetesPeatonales.setServiceSuspended(molinetePed23, molinetesOperativosPed < 23);
molinetesPeatonales.setServiceSuspended(molinetePed24, molinetesOperativosPed < 24);
molinetesPeatonales.setServiceSuspended(molinetePed25, molinetesOperativosPed < 25);
molinetesPeatonales.setServiceSuspended(molinetePed26, molinetesOperativosPed < 26);
molinetesPeatonales.setServiceSuspended(molinetePed27, molinetesOperativosPed < 27);
molinetesPeatonales.setServiceSuspended(molinetePed28, molinetesOperativosPed < 28);]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1792000000022</Id>
					<Name><![CDATA[inicializarPed]]></Name>
					<X>463</X><Y>-379</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (horizonteMetricasPedSeg <= 0) throw new IllegalArgumentException("horizonteMetricasPedSeg debe ser positivo");
if (inicioPicoPedSeg < 0 || finPicoPedSeg <= inicioPicoPedSeg) throw new IllegalArgumentException("Cohorte pico invalida");
if (modoFranjaPed) {
    if (proporcionRocaPed < 0 || proporcionRocaPed > 1 || demoraAccesoRocaSeg < 0 || duracionDescargaSeg <= 0 || servicioPedSeg <= 0)
        throw new IllegalArgumentException("Franja peatonal PENDIENTE DE CALIBRACION: completar proporcionRocaPed, "
            + "demoraAccesoRocaSeg, duracionDescargaSeg y servicioPedSeg con mediciones o rangos aprobados");
    // El horario cargado arranca a las 06:30: una demora mayor a 1800 s dejaria sin trenes la primera ventana.
    if (demoraAccesoRocaSeg > 1800)
        throw new IllegalArgumentException("demoraAccesoRocaSeg > 1800 s: el horario del Roca cargado empieza a las 06:30");
    boolean triangular = servicioMinPedSeg >= 0 || servicioMaxPedSeg >= 0;
    if (triangular && !(servicioMinPedSeg > 0 && servicioMinPedSeg <= servicioPedSeg && servicioPedSeg <= servicioMaxPedSeg))
        throw new IllegalArgumentException("Servicio triangular: requiere 0 < servicioMinPedSeg <= servicioPedSeg <= servicioMaxPedSeg");
    if (factorDemandaPed <= 0) throw new IllegalArgumentException("factorDemandaPed debe ser positivo");
    if (horizonteArribosPedSeg <= 0 || horizonteArribosPedSeg > 9000)
        throw new IllegalArgumentException("horizonteArribosPedSeg debe estar en (0, 9000]");
    if (perfilPed15min == null || perfilPed15min.length != 10)
        throw new IllegalArgumentException("perfilPed15min: diez ventanas de 15 minutos");
    for (double v : perfilPed15min)
        if (!Double.isFinite(v) || v < 0) throw new IllegalArgumentException("perfilPed15min invalido");
    // Dia de la replica (bootstrap): -1 perfil medio; -2 un dia habil real sorteado con la semilla, el mismo para
    // todos los escenarios del par (numeros aleatorios comunes); >= 0 dia fijo de perfilesDiasPed.
    if (diaSbasePed == -1) {
        diaEfectivoPed = -1;
        perfilEfectivoPed = perfilPed15min;
    } else {
        if (diaSbasePed < -2) throw new IllegalArgumentException("diaSbasePed: -1, -2 o un dia >= 0");
        if (perfilesDiasPed == null || perfilesDiasPed.length == 0)
            throw new IllegalArgumentException("perfilesDiasPed vacio: correr datos/embeber_dias_sbase.py");
        diaEfectivoPed = diaSbasePed >= 0 ? diaSbasePed
            : (int) Math.floorMod(mezclarSemillaPed(semillaPed, 4), (long) perfilesDiasPed.length);
        if (diaEfectivoPed >= perfilesDiasPed.length) throw new IllegalArgumentException("diaSbasePed fuera de rango");
        perfilEfectivoPed = perfilesDiasPed[diaEfectivoPed];
        if (perfilEfectivoPed == null || perfilEfectivoPed.length != 10)
            throw new IllegalArgumentException("perfilesDiasPed: diez ventanas por dia");
        for (double v : perfilEfectivoPed)
            if (!Double.isFinite(v) || v < 0) throw new IllegalArgumentException("perfilesDiasPed invalido");
    }
    if (llegadasRealesPed && diaEfectivoPed >= 0) {
        if (llegadasDiasPed == null || ramalesDiasPed == null || llegadasDiasPed.length != perfilesDiasPed.length
            || ramalesDiasPed.length != perfilesDiasPed.length)
            throw new IllegalArgumentException("llegadasDiasPed/ramalesDiasPed no alineados con perfilesDiasPed");
        double[] t = llegadasDiasPed[diaEfectivoPed];
        if (t.length == 0 || t.length != ramalesDiasPed[diaEfectivoPed].length)
            throw new IllegalArgumentException("llegadas reales vacias o sin ramal en el dia " + diaEfectivoPed);
        for (int j = 1; j < t.length; j++)
            if (!(t[j] >= t[j - 1])) throw new IllegalArgumentException("llegadas reales desordenadas");
    }
    if (!(atrasoMaxRocaSeg >= 0) || atrasoMaxRocaSeg > 300)
        throw new IllegalArgumentException("atrasoMaxRocaSeg debe estar en [0, 300] s");
    if (llegadasRocaSeg == null) throw new IllegalArgumentException("llegadasRocaSeg: falta el horario del Roca");
    for (double t : llegadasRocaSeg)
        if (!Double.isFinite(t)) throw new IllegalArgumentException("llegadasRocaSeg invalido");
    horizonteCortePed = horizonteArribosPedSeg;
} else {
    if (tamanoTandaDemo < 0 || intervaloTandaDemoSeg <= 0 || cantidadTandasDemo <= 0 || servicioDemoSeg <= 0)
        throw new IllegalArgumentException("Parametros de la demo peatonal invalidos");
    horizonteCortePed = horizonteMetricasPedSeg;
    diaEfectivoPed = -1;
    perfilEfectivoPed = perfilPed15min;
}
// La semilla efectiva es semillaPed. La calle y el servicio usan generadores propios para que E0 y E1
// reciban exactamente los mismos arribos y tiempos de validacion (numeros aleatorios comunes).
getDefaultRandomGenerator().setSeed(semillaPed);
// Cada flujo recibe una semilla mezclada (mezclarSemillaPed): con java.util.Random, semillas que
// difieren en poco (antes +11 y +29) dan primeros numeros casi iguales y flujos correlacionados.
rngCallePed.setSeed(mezclarSemillaPed(semillaPed, 1));
rngServicioPed.setSeed(mezclarSemillaPed(semillaPed, 2));
// La velocidad de cada peaton usa su propio generador: el generador por defecto lo consume tambien
// la Pedestrian Library, en un orden que depende del escenario, y rompia los numeros comunes E0/E1.
rngVelocidadPed.setSeed(mezclarSemillaPed(semillaPed, 3));
// Atraso y carga de los trenes: flujo propio, sorteado en el orden del horario (igual en todos los escenarios).
rngTrenesPed.setSeed(mezclarSemillaPed(semillaPed, 5));
inicioRealMsPed = System.currentTimeMillis();
inicializadoPed = true;]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1792000000024</Id>
					<Name><![CDATA[drenadoPed]]></Name>
					<X>-1077</X><Y>-486</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return arribosCerradosPed && nProcesadosPed == nInyectadosPed;]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1792000000025</Id>
					<Name><![CDATA[prefijoResultadoPed]]></Name>
					<X>-1077</X><Y>-430</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return modoFranjaPed && !pruebaSinteticaPed ? "CSV_PEATONAL" : "CSV_PEATONAL_DEMO";]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1792000000026</Id>
					<Name><![CDATA[escribirFilaPed]]></Name>
					<X>-1077</X><Y>-402</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[linea]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (archivoSalidaPed == null || archivoSalidaPed.trim().isEmpty()) return;
escribirLineaPed(archivoSalidaPed, linea);]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1792000000027</Id>
					<Name><![CDATA[emitirIncompletoPed]]></Name>
					<X>-1077</X><Y>-514</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Si la inicializacion fallo, el error ya figura en consola y no hay corrida que reportar.
if (resultadoEmitidoPed || !inicializadoPed) return;
resultadoEmitidoPed = true;
String linea = "CSV_PEATONAL_INCOMPLETO;" + filaResultadoPed() + ";inyectados=" + nInyectadosPed + ";t=" + time();
traceln("ADVERTENCIA: la corrida termino sin drenar la cohorte; no usar como replica.");
traceln(resumenPeatonal());
traceln(linea);
escribirFilaPed(linea);]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1793000000010</Id>
					<Name><![CDATA[hallPed]]></Name>
					<X>-1077</X><Y>-346</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Peatones que ingresaron al vestibulo y todavia no llegaron a un molinete (ni a su cola):
// caminan por la zona no paga. Si crece sin limite, el cuello de botella es el movimiento, no la validacion.
return nGeneradosPed - nLlegadosMolinetePed;]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1793000000011</Id>
					<Name><![CDATA[pagaPed]]></Name>
					<X>-1077</X><Y>-318</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Peatones que empezaron a validar y todavia no salieron por las escaleras a andenes.
return nEsperasPed - nProcesadosPed;]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1793000000012</Id>
					<Name><![CDATA[actualizarTransitoPed]]></Name>
					<X>1333</X><Y>-281</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[int hall = hallPed();
if (hall > hallMaxPed) {
    hallMaxPed = hall;
    tHallMaxPed = time();
}
pagaMaxPed = Math.max(pagaMaxPed, pagaPed());]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1793000000013</Id>
					<Name><![CDATA[segundosRealesPed]]></Name>
					<X>-1077</X><Y>-290</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Tiempo de pared desde la inicializacion: mide el costo de computo de la corrida.
return inicioRealMsPed <= 0 ? 0 : (System.currentTimeMillis() - inicioRealMsPed) / 1000.0;]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1793000000014</Id>
					<Name><![CDATA[intervaloProgresoPed]]></Name>
					<X>-1077</X><Y>-262</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return modoFranjaPed ? 900 : 300;]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[QueuePath]]></ReturnType>
					<Id>1792000000183</Id>
					<Name><![CDATA[elegirColaPed]]></Name>
					<X>1333</X><Y>-449</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[ped]]></Name>
						<Type><![CDATA[Pasajero]]></Type>
					</Parameter>
					<Body><![CDATA[// Supuesto de comportamiento (plano hipotetico): cada pasajero elige, entre los molinetes
// habilitados, la cola que minimiza el desvio lateral a 1,3 m/s mas la espera estimada por las
// personas ya asignadas a ese molinete que todavia no empezaron a validar (asignadosPed: las que
// van caminando y las que estan en la fila). Se usa un contador propio y no queueSize(): el piloto
// del 2026-10-05 mostro colas de 40 personas junto a molinetes habilitados sin uso (efecto manada).
// Los molinetes suspendidos nunca se eligen.
liberaAsignacionPed(ped);
// La espera por persona se estima con el servicio de referencia del escenario, no con el sorteo
// propio del pasajero: AnyLogic evalua esta eleccion antes del On exit de pedSource, donde se
// sortea servicioAsignadoPed, y con 0 la fila no pesaba (piloto del 2026-10-05).
if (ped.servicioAsignadoPed <= 0) eleccionesSinServicioPed++;
double servicio = modoFranjaPed ? servicioPedSeg : servicioDemoSeg;
// La eleccion se evalua al aparecer el pasajero. El pasaje del Roca aparece en el hall (X < 80), en la cabecera
// de su anden, y entra al vestibulo por la boca oeste del pasillo (Y 335-385): el desvio se mide desde esa boca,
// repartiendo los carriles segun la posicion de aparicion.
double yReferencia = ped.getX() < 80 ? 335 + (((ped.getY() % 50) + 50) % 50) : ped.getY();
java.util.List<QueuePath> colas = molinetesPeatonales.getQueues();
int mejor = -1;
double mejorCosto = Double.MAX_VALUE;
for (int i = 0; i < molinetesOperativosPed && i < colas.size(); i++) {
    QueuePath cola = colas.get(i);
    double desvioSeg = Math.abs(yReferencia - cola.getEndPoint().y) / 10.0 / 1.3;
    double costo = desvioSeg + asignadosPed[i] * servicio;
    if (costo < mejorCosto) {
        mejorCosto = costo;
        mejor = i;
    }
}
if (mejor < 0) throw new IllegalStateException("No hay molinetes habilitados");
asignadosPed[mejor]++;
ped.colaElegidaPed = mejor;
return colas.get(mejor);]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1792000000324</Id>
					<Name><![CDATA[programarDemandaFranjaPed]]></Name>
					<X>463</X><Y>-351</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Roca: cada tren lleva la demanda acumulada desde el tren anterior de SU ramal (la gente espera en las
// estaciones de su ramal: dos trenes que llegan juntos de ramales distintos no se reparten la misma gente).
// La tasa es la del perfil SBASE en el instante de ingreso; antes de las 07:00 se extiende la de la primera
// ventana. Cada ramal toma la parte de la demanda proporcional a sus trenes en la franja. El pasaje sale de la
// cabecera del anden de forma pareja durante duracionDescargaSeg, a partir de demoraAccesoRocaSeg.
// Solo cuentan los ingresos anteriores al cierre (09:30). Con atrasoMaxRocaSeg > 0 cada tren llega tarde un
// tiempo uniforme [SUP]; con cargaTrenPoissonPed su pasaje es Poisson. El perfil es el del dia de la replica.
double h = horizonteArribosPedSeg;
java.util.function.DoubleUnaryOperator acumulada = s -> {
    if (s < 0) return perfilEfectivoPed[0] * s / 900.0;
    double tope = Math.min(s, 900.0 * perfilEfectivoPed.length);
    int k = (int) Math.floor(tope / 900.0);
    double a = 0;
    for (int i = 0; i < k && i < perfilEfectivoPed.length; i++) a += perfilEfectivoPed[i];
    if (k < perfilEfectivoPed.length) a += perfilEfectivoPed[k] * (tope - 900.0 * k) / 900.0;
    return a;
};
// Trenes: horario oficial (llegadasRocaSeg) o, con llegadasRealesPed y un dia SBASE, las llegadas reales de ese dia.
boolean reales = llegadasRealesPed && diaEfectivoPed >= 0;
double[] llegadas = reales ? llegadasDiasPed[diaEfectivoPed] : llegadasRocaSeg;
int[] ramales = reales ? ramalesDiasPed[diaEfectivoPed] : ramalRocaPed;
// Via de cada tren (solo animacion y anden de descenso): la primera libre a partir de j % 7. El tren ocupa la via
// desde que aparece (10 s antes) hasta que se retira: llega a la parada y espera permanencia (trenesRocaDescarga),
// mas 15 s de margen. Con el horario oficial siempre queda
// libre la via j % 7, como antes; con llegadas reales pueden llegar trenes juntos.
double permanencia = Math.max(demoraAccesoRocaSeg + duracionDescargaSeg + 10, 600);
double[] viaLibreDesde = new double[7];
java.util.Arrays.fill(viaLibreDesde, Double.NEGATIVE_INFINITY);
// Atraso de cada tren [SUP] (uniforme en [0, atrasoMaxRocaSeg]); se sortea para todo el horario, en orden.
double[] atrasoTren = new double[llegadas.length];
for (int j = 0; j < llegadas.length; j++)
    atrasoTren[j] = atrasoMaxRocaSeg > 0 ? atrasoMaxRocaSeg * rngTrenesPed.nextDouble() : 0;
int nRamales = 0;
for (int b : ramales) nRamales = Math.max(nRamales, b + 1);
int[] trenesRamal = new int[nRamales];
int enFranja = 0;
for (int j = 0; j < llegadas.length; j++) {
    double ingreso = llegadas[j] + atrasoTren[j] + demoraAccesoRocaSeg;
    if (ingreso >= 0 && ingreso < h) { trenesRamal[ramales[j]]++; enFranja++; }
}
double[] ingresoAnterior = new double[nRamales];
java.util.Arrays.fill(ingresoAnterior, Double.NaN);
double[] resto = new double[nRamales];
// Primera pasada: media de cada tren = demanda acumulada de su ramal desde el tren anterior del mismo ramal.
// Si el atraso invierte dos trenes de un ramal, el anterior no retrocede (no se cuenta dos veces ni se pierde).
double[] mediaTren = new double[llegadas.length];
double sumaMedias = 0;
for (int j = 0; j < llegadas.length; j++) {
    int b = ramales[j];
    double ingreso = llegadas[j] + atrasoTren[j] + demoraAccesoRocaSeg;
    // Sin tren anterior del ramal en el horario cargado: se toman 15 minutos de acumulacion.
    double desde = Double.isNaN(ingresoAnterior[b]) ? ingreso - 900.0 : Math.min(ingresoAnterior[b], ingreso);
    ingresoAnterior[b] = Double.isNaN(ingresoAnterior[b]) ? ingreso : Math.max(ingresoAnterior[b], ingreso);
    if (ingreso < 0 || ingreso >= h) continue;
    mediaTren[j] = factorDemandaPed * proporcionRocaPed * trenesRamal[b] / enFranja
        * Math.max(0, acumulada.applyAsDouble(ingreso) - acumulada.applyAsDouble(desde));
    sumaMedias += mediaTren[j];
}
// El total del Roca en la franja es el del dato (proporcionRocaPed del perfil del dia hasta el cierre): la
// acumulacion por ramal pierde la gente que llega despues del ultimo tren de cada ramal y da 15 min al primero,
// asi que se reescala. La forma (que tren viene mas cargado) no cambia.
double objetivoRoca = factorDemandaPed * proporcionRocaPed * (acumulada.applyAsDouble(h) - acumulada.applyAsDouble(0));
double escalaRoca = sumaMedias > 0 ? objetivoRoca / sumaMedias : 0;
for (int j = 0; j < llegadas.length; j++) {
    int b = ramales[j];
    double ingreso = llegadas[j] + atrasoTren[j] + demoraAccesoRocaSeg;
    if (ingreso < 0 || ingreso >= h) continue;
    double media = mediaTren[j] * escalaRoca;
    int n;
    if (cargaTrenPoissonPed) {
        // Pasaje del tren aleatorio [SUP]: Poisson con la demanda acumulada como media (sin arrastre).
        n = poissonTrenPed(media);
    } else {
        double carga = media + resto[b];
        n = (int) Math.round(carga);
        resto[b] = carga - n;
    }
    // Cada tren descarga en un anden (islas 2-3 ... 12-13 y anden 14). No hay dato de anden por tren:
    // se asignan por turno, en el orden del horario, salteando las vias ocupadas [SUP].
    double aparece = llegadas[j] + atrasoTren[j] - 10;
    int anden = j % 7;
    for (int v = 0; v < 7; v++) {
        int c = (j + v) % 7;
        if (viaLibreDesde[c] <= aparece) { anden = c; break; }
        if (viaLibreDesde[c] < viaLibreDesde[anden]) anden = c;
    }
    if (viaLibreDesde[anden] > aparece) traceln("ADVERTENCIA: tren " + j + " en una via ocupada (" + anden + ")");
    viaLibreDesde[anden] = llegadas[j] + atrasoTren[j] + permanencia + 15;
    nTrenesPed++;
    // Vista: el tren aparece 10 s antes de su llegada, 60 m antes de la parada (solo animacion, no cambia la demanda).
    trenesRocaPed.add(new double[] {Math.max(0, llegadas[j] + atrasoTren[j] - 10), anden});
    for (int i = 0; i < n; i++) {
        double r = ingreso + (i + 0.5) * duracionDescargaSeg / n;
        if (r < h) liberacionesPed.add(new double[] {r, anden});
    }
}
if (!trenesRocaPed.isEmpty()) proximoTrenRocaPed.restart(Math.max(0, trenesRocaPed.peek()[0] - time()));
if (liberacionesPed.isEmpty()) {
    rocaCerradoPed = true;
    cerrarArribosSiCorrespondePed();
} else {
    proximaLiberacionPed.restart(Math.max(0, liberacionesPed.peek()[0] - time()));
}
programarLlegadaCallePed(time());]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1800000000014</Id>
					<Name><![CDATA[poissonTrenPed]]></Name>
					<X>463</X><Y>-323</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[media]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[// Poisson(media) contando llegadas de un proceso de tasa 1 en [0, media] (sin desborde para medias grandes).
if (!(media > 0)) return 0;
int k = 0;
double t = -Math.log(1 - rngTrenesPed.nextDouble());
while (t <= media) {
    k++;
    t += -Math.log(1 - rngTrenesPed.nextDouble());
}
return k;]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1800000000015</Id>
					<Name><![CDATA[p90TransitoRocaPed]]></Name>
					<X>-1077</X><Y>-780</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (transitosRocaPed.isEmpty()) return 0;
java.util.ArrayList<Double> ordenados = new java.util.ArrayList<Double>(transitosRocaPed);
java.util.Collections.sort(ordenados);
return ordenados.get(Math.max(0, (int)Math.ceil(0.9 * ordenados.size()) - 1));]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1800000000016</Id>
					<Name><![CDATA[cvValidacionesMolinetePed]]></Name>
					<X>-1077</X><Y>-752</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Coeficiente de variacion de las validaciones entre los molinetes habilitados (se compara con SBASE).
if (molinetesOperativosPed <= 0) return 0;
double suma = 0, suma2 = 0;
for (int i = 1; i <= molinetesOperativosPed; i++) {
    Integer v = validacionesPorMolinetePed.get(String.format("molinetePed%02d", i));
    double x = v == null ? 0 : v;
    suma += x;
    suma2 += x * x;
}
double media = suma / molinetesOperativosPed;
if (media <= 0) return 0;
return Math.sqrt(Math.max(0, suma2 / molinetesOperativosPed - media * media)) / media;]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1800000000017</Id>
					<Name><![CDATA[escenarioPed]]></Name>
					<X>-1077</X><Y>-570</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// E0 = 20 molinetes, E1 = 22, E1B = 28 (ampliacion hipotetica); con validacion rapida (moda < 2 s, EMV/QR) E3 = 20
// y E13 = 22. La moda intermedia es 2,4 s y la de E3 1,8 s.
boolean rapida = modoFranjaPed && servicioPedSeg > 0 && servicioPedSeg < 2.0;
String base = molinetesOperativosPed == 20 ? "E0" : (molinetesOperativosPed == 22 ? "E1"
    : (molinetesOperativosPed == 28 ? "E1B" : "M" + molinetesOperativosPed));
if (!rapida) return base;
return molinetesOperativosPed == 20 ? "E3" : (molinetesOperativosPed == 22 ? "E13" : base + "R");]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1800000000018</Id>
					<Name><![CDATA[filaVentanasPed]]></Name>
					<X>-1077</X><Y>-626</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Validaciones simuladas y observadas (perfil del dia de la replica) por ventana de 15 min, para la validacion.
StringBuilder sb = new StringBuilder();
sb.append(escenarioPed()).append(';').append(semillaPed).append(';').append(diaEfectivoPed);
for (int w = 0; w < validacionesPorVentanaPed.length; w++) sb.append(';').append(validacionesPorVentanaPed[w]);
for (int w = 0; w < validacionesPorVentanaPed.length; w++)
    sb.append(';').append(String.format(java.util.Locale.US, "%.1f", w < perfilEfectivoPed.length ? factorDemandaPed * perfilEfectivoPed[w] : 0));
return sb.toString();]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1800000000019</Id>
					<Name><![CDATA[escribirLineaPed]]></Name>
					<X>-1077</X><Y>-374</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[archivo]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[linea]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[// Con evaluaciones en paralelo varias corridas pueden terminar a la vez: se serializa la escritura
// con un monitor unico del JVM para que ninguna linea se intercale con otra.
synchronized (java.nio.file.Files.class) {
try {
    java.nio.file.Path ruta = java.nio.file.Paths.get(archivo).toAbsolutePath();
    java.nio.file.Files.write(ruta, java.util.Collections.singletonList(linea), java.nio.charset.StandardCharsets.UTF_8,
        java.nio.file.StandardOpenOption.CREATE, java.nio.file.StandardOpenOption.APPEND);
    traceln("Fila agregada a " + ruta);
} catch (java.io.IOException e) {
    throw new RuntimeException("No se pudo escribir " + archivo, e);
}
}]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1799000000021</Id>
					<Name><![CDATA[xPuertaPed]]></Name>
					<X>1333</X><Y>-589</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[puerta]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[// Puertas del tren detenido: 7 coches de 23 m (cabeza en X = -830), 3 puertas por lado en cada coche (CSR del Roca),
// a 1/6, 1/2 y 5/6 del largo del coche. Devuelve la X (px) de la puerta 0..20.
int coche = puerta / 3, k = puerta % 3;
return -830 - 230 * coche - 230 * (2 * k + 1) / 6.0;]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1799000000022</Id>
					<Name><![CDATA[yPuertaPed]]></Name>
					<X>1333</X><Y>-561</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[anden]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[// Y (px) del punto de descenso: 0,8 m adentro del borde del andén que da a la vía del tren (bordeAndenRoca*).
double[] borde = {354, 528, 700, 877, 1052, 1227, 1316};
return borde[anden];]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1792000000325</Id>
					<Name><![CDATA[liberarPendientesPed]]></Name>
					<X>1333</X><Y>-617</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Cada pasajero del Roca baja por una puerta de su tren: andenActualPed fija el anden y nDesdeRocaPed reparte las
// 21 puertas por turno (xPuertaPed, yPuertaPed en pedSource). Despues camina el anden y el hall hasta la escalera de su lado.
int k = 0;
while (!liberacionesPed.isEmpty() && liberacionesPed.peek()[0] <= time() + 1e-9) {
    andenActualPed = (int) liberacionesPed.poll()[1];
    k++;
    nInyectadosPed++;
    nDesdeRocaPed++;
    pedSource.inject(1);
}
if (k > 0) {
    nTandasPed++;
    tiempoUltimaTandaPed = time();
}
if (liberacionesPed.isEmpty()) {
    rocaCerradoPed = true;
    cerrarArribosSiCorrespondePed();
} else {
    proximaLiberacionPed.restart(liberacionesPed.peek()[0] - time());
}]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1792000000326</Id>
					<Name><![CDATA[llegadaCallePed]]></Name>
					<X>1333</X><Y>-533</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (time() >= horizonteArribosPedSeg) {
    calleCerradaPed = true;
    cerrarArribosSiCorrespondePed();
    return;
}
tiempoUltimaTandaPed = time();
nInyectadosPed++;
nDesdeCallePed++;
pedSourceCalle.inject(1);
programarLlegadaCallePed(time());]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1792000000327</Id>
					<Name><![CDATA[programarLlegadaCallePed]]></Name>
					<X>463</X><Y>-295</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[desde]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[// Poisson no homogeneo por adelgazamiento: la tasa de cada ventana es la parte de calle del perfil SBASE.
double tasaMax = 0;
for (double v : perfilEfectivoPed) tasaMax = Math.max(tasaMax, factorDemandaPed * v * (1 - proporcionRocaPed) / 900.0);
if (tasaMax <= 0) {
    calleCerradaPed = true;
    cerrarArribosSiCorrespondePed();
    return;
}
double t = desde;
while (true) {
    t += -Math.log(1 - rngCallePed.nextDouble()) / tasaMax;
    if (t >= horizonteArribosPedSeg) {
        calleCerradaPed = true;
        cerrarArribosSiCorrespondePed();
        return;
    }
    int ventana = Math.min(perfilEfectivoPed.length - 1, (int)Math.floor(t / 900.0));
    double tasa = factorDemandaPed * perfilEfectivoPed[ventana] * (1 - proporcionRocaPed) / 900.0;
    if (rngCallePed.nextDouble() * tasaMax <= tasa) break;
}
proximaLlegadaCallePed.restart(t - time());]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1792000000328</Id>
					<Name><![CDATA[cerrarArribosSiCorrespondePed]]></Name>
					<X>1333</X><Y>-225</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (rocaCerradoPed && calleCerradaPed) arribosCerradosPed = true;]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792000000329</Id>
					<Name><![CDATA[tiempoServicioPed]]></Name>
					<X>1333</X><Y>-477</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (servicioMinPedSeg < 0) return servicioPedSeg;
double a = servicioMinPedSeg, c = servicioPedSeg, b = servicioMaxPedSeg;
if (b <= a) return c;
double u = rngServicioPed.nextDouble();
double corte = (c - a) / (b - a);
return u < corte ? a + Math.sqrt(u * (b - a) * (c - a)) : b - Math.sqrt((1 - u) * (b - a) * (b - c));]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1792000000330</Id>
					<Name><![CDATA[caudalPorVentanaPed]]></Name>
					<X>-1077</X><Y>-654</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Validaciones simuladas por ventana de 15 minutos frente al perfil SBASE escalado (control de calibracion).
java.util.ArrayList<String> partes = new java.util.ArrayList<String>();
for (int w = 0; w < validacionesPorVentanaPed.length && w < perfilEfectivoPed.length; w++) {
    int minutos = 7 * 60 + 15 * w;
    partes.add(String.format(java.util.Locale.US, "%02d:%02d sim=%d obs=%.0f", minutos / 60, minutos % 60,
        validacionesPorVentanaPed[w], factorDemandaPed * perfilEfectivoPed[w]));
}
return String.join(",", partes);]]></Body>
				</Function>
			</Functions>

