        <Functions>
          <Function AccessType="public" StaticFunction="false"><ReturnModificator>VOID</ReturnModificator><ReturnType>void</ReturnType><Id>1791000000084</Id><Name>actualizarAreaColaPed</Name><X>1500</X><Y>60</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Body>double ahora = Math.min(time(), horizonteCortePed);
areaColaPed += nEsperandoPed * Math.max(0, ahora - tAreaColaPed);
tAreaColaPed = ahora;</Body></Function>
          <Function AccessType="public" StaticFunction="false"><ReturnModificator>VOID</ReturnModificator><ReturnType>void</ReturnType><Id>1791000000085</Id><Name>entraColaPed</Name><X>1500</X><Y>95</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Parameter><Name>ped</Name><Type>Pasajero</Type></Parameter><Body>actualizarAreaColaPed();
ped.enColaPed = true;
nEsperandoPed++;
qMaxPed = Math.max(qMaxPed, nEsperandoPed);</Body></Function>
          <Function AccessType="public" StaticFunction="false"><ReturnModificator>VOID</ReturnModificator><ReturnType>void</ReturnType><Id>1791000000160</Id><Name>registraIngresoPed</Name><X>1500</X><Y>112</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Parameter><Name>ped</Name><Type>Pasajero</Type></Parameter><Body>nGeneradosPed++;
ped.tIngresoSistemaPed = time();
ped.enPicoPed = time() &gt;= inicioPicoPedSeg &amp;&amp; time() &lt; finPicoPedSeg;
// Punto de extension: con una distribucion ajustada, muestrearla aqui con un generador propio
// en orden de llegada, para conservar numeros aleatorios comunes entre E0 y E1.
ped.servicioAsignadoPed = modoFranjaPed ? servicioPedSeg : servicioDemoSeg;</Body></Function>
          <Function AccessType="public" StaticFunction="false"><ReturnModificator>VOID</ReturnModificator><ReturnType>void</ReturnType><Id>1791000000086</Id><Name>comienzaServicioPed</Name><X>1500</X><Y>130</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Parameter><Name>ped</Name><Type>Pasajero</Type></Parameter><Body>if (ped.enColaPed) {
    actualizarAreaColaPed();
    nEsperandoPed--;
    ped.enColaPed = false;
}
double espera = Math.max(0, time() - ped.tEntradaColaPed);
sumaEsperaPed += espera;
nEsperasPed++;
esperaMaxPed = Math.max(esperaMaxPed, espera);
esperasPed.add(espera);
if (espera &gt; 30) nMas30Ped++;
if (ped.enPicoPed) esperasPicoPed.add(espera);
ped.tInicioServicioPed = time();</Body></Function>
          <Function AccessType="public" StaticFunction="false"><ReturnModificator>VOID</ReturnModificator><ReturnType>void</ReturnType><Id>1791000000161</Id><Name>terminaServicioPed</Name><X>1500</X><Y>147</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Parameter><Name>ped</Name><Type>Pasajero</Type></Parameter><Body>double inicio = Math.min(ped.tInicioServicioPed, horizonteCortePed);
double fin = Math.min(time(), horizonteCortePed);
double ocupado = Math.max(0, fin - inicio);
Double previo = ocupacionPorMolinetePed.get(ped.nombreMolinetePed);
ocupacionPorMolinetePed.put(ped.nombreMolinetePed, (previo == null ? 0 : previo) + ocupado);</Body></Function>
          <Function AccessType="public" StaticFunction="false"><ReturnModificator>VOID</ReturnModificator><ReturnType>void</ReturnType><Id>1791000000087</Id><Name>generarTandaPed</Name><X>1500</X><Y>165</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Body>if (arribosCerradosPed) return;
if (modoFranjaPed &amp;&amp; time() &gt;= horizonteArribosPedSeg) {
    arribosCerradosPed = true;
    return;
}
int n = tamanoTandaActualPed();
nTandasPed++;
if (n &gt; 0) {
    tiempoUltimaTandaPed = time();
    nInyectadosPed += n;
    pedSource.inject(n);
}
if (modoFranjaPed) {
    if (time() + intervaloTandaPedSeg &lt; horizonteArribosPedSeg) proximaTandaPed.restart(intervaloTandaPedSeg);
    else arribosCerradosPed = true;
} else {
    if (nTandasPed &lt; cantidadTandasDemo) proximaTandaPed.restart(intervaloTandaDemoSeg);
    else arribosCerradosPed = true;
}</Body></Function>
          <Function AccessType="public" StaticFunction="false"><ReturnModificator>VOID</ReturnModificator><ReturnType>void</ReturnType><Id>1791000000088</Id><Name>salePed</Name><X>1500</X><Y>200</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Body>nProcesadosPed++;
if (drenadoPed()) {
    actualizarAreaColaPed();
    ultimaDisipacionPed = time() - tiempoUltimaTandaPed;
    if (time() &gt;= horizonteCortePed) emitirResultadoPed();
}</Body></Function>
          <Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>double</ReturnType><Id>1791000000089</Id><Name>esperaMediaPed</Name><X>1500</X><Y>235</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Body>return nEsperasPed == 0 ? 0 : sumaEsperaPed/nEsperasPed;</Body></Function>
          <Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>double</ReturnType><Id>1791000000162</Id><Name>percentil90Ped</Name><X>1750</X><Y>95</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Body>if (esperasPed.isEmpty()) return 0;
java.util.ArrayList&lt;Double&gt; ordenadas = new java.util.ArrayList&lt;Double&gt;(esperasPed);
java.util.Collections.sort(ordenadas);
int posicion = Math.max(0, (int)Math.ceil(0.9 * ordenadas.size()) - 1);
return ordenadas.get(posicion);</Body></Function>
          <Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>double</ReturnType><Id>1791000000163</Id><Name>proporcionMas30Ped</Name><X>1750</X><Y>130</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Body>return nEsperasPed == 0 ? 0 : (double)nMas30Ped/nEsperasPed;</Body></Function>
          <Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>double</ReturnType><Id>1791000000164</Id><Name>esperaMediaPicoPed</Name><X>1750</X><Y>165</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Body>if (esperasPicoPed.isEmpty()) return 0;
double suma = 0;
for (double valor : esperasPicoPed) suma += valor;
return suma/esperasPicoPed.size();</Body></Function>
          <Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>double</ReturnType><Id>1791000000165</Id><Name>p90PicoPed</Name><X>1750</X><Y>200</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Body>if (esperasPicoPed.isEmpty()) return 0;
java.util.ArrayList&lt;Double&gt; ordenadas = new java.util.ArrayList&lt;Double&gt;(esperasPicoPed);
java.util.Collections.sort(ordenadas);
int posicion = Math.max(0, (int)Math.ceil(0.9 * ordenadas.size()) - 1);
return ordenadas.get(posicion);</Body></Function>
          <Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>double</ReturnType><Id>1791000000166</Id><Name>utilizacionMediaPed</Name><X>1750</X><Y>235</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Body>if (horizonteCortePed &lt;= 0 || molinetesOperativosPed &lt;= 0) return 0;
double ocupacion = 0;
for (double valor : ocupacionPorMolinetePed.values()) ocupacion += valor;
return ocupacion/(horizonteCortePed*molinetesOperativosPed);</Body></Function>
          <Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>double</ReturnType><Id>1791000000167</Id><Name>dispersionUtilizacionPed</Name><X>1750</X><Y>270</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Body>if (horizonteCortePed &lt;= 0 || molinetesOperativosPed &lt;= 0) return 0;
double media = utilizacionMediaPed();
double suma = 0;
for (int i=1; i&lt;=molinetesOperativosPed; i++) {
    String nombre = String.format("molinetePed%02d", i);
    double u = ocupacionPorMolinetePed.containsKey(nombre) ? ocupacionPorMolinetePed.get(nombre)/horizonteCortePed : 0;
    suma += (u-media)*(u-media);
}
return Math.sqrt(suma/molinetesOperativosPed);</Body></Function>
          <Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>String</ReturnType><Id>1791000000168</Id><Name>utilizacionPorMolinetePed</Name><X>1750</X><Y>305</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Body>java.util.ArrayList&lt;String&gt; partes = new java.util.ArrayList&lt;String&gt;();
for (int i=1; i&lt;=molinetesOperativosPed; i++) {
    String nombre = String.format("molinetePed%02d", i);
    double ocupado = ocupacionPorMolinetePed.containsKey(nombre) ? ocupacionPorMolinetePed.get(nombre) : 0;
    partes.add(nombre + "=" + String.format(java.util.Locale.US, "%.3f", ocupado/horizonteCortePed));
}
return String.join(",", partes);</Body></Function>
          <Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>double</ReturnType><Id>1791000000090</Id><Name>lqPed</Name><X>1500</X><Y>270</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Body>double fin = Math.min(time(), horizonteCortePed);
if (fin &lt;= 0) return 0;
double acumulada = areaColaPed + nEsperandoPed*Math.max(0, fin-tAreaColaPed);
return acumulada/fin;</Body></Function>
          <Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>String</ReturnType><Id>1791000000091</Id><Name>resumenPeatonal</Name><X>1500</X><Y>305</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Body>return (modoFranjaPed ? "FRANJA PEATONAL - ENTRADAS PENDIENTES DE CALIBRACION - GEOMETRIA SINTETICA" : "DEMO PEATONAL SINTETICA")
 + "; corteSeg=" + horizonteCortePed + "; tandas=" + nTandasPed + "; inyectados=" + nInyectadosPed
 + "; generados=" + nGeneradosPed + "; procesados=" + nProcesadosPed
 + "; molinetesOperativos=" + molinetesOperativosPed
 + "; esperaMediaSeg=" + esperaMediaPed() + "; p90Seg=" + percentil90Ped()
 + "; proporcionMas30=" + proporcionMas30Ped() + "; esperaMaxSeg=" + esperaMaxPed
 + "; qMax=" + qMaxPed + "; Lq=" + lqPed()
 + "; utilizacionMedia=" + utilizacionMediaPed() + "; dispersionUtilizacion=" + dispersionUtilizacionPed()
 + "; cohortePicoN=" + esperasPicoPed.size() + "; cohortePicoEsperaMediaSeg=" + esperaMediaPicoPed()
 + "; cohortePicoP90Seg=" + p90PicoPed() + "; disipacionUltimaTandaSeg=" + ultimaDisipacionPed
 + "; utilizacionPorMolinete=" + utilizacionPorMolinetePed();</Body></Function>
          <Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>String</ReturnType><Id>1791000000181</Id><Name>filaResultadoPed</Name><X>1750</X><Y>340</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Body>String escenarioPed = molinetesOperativosPed == 20 ? "E0" : (molinetesOperativosPed == 28 ? "E1" : "OTRO");
return String.join(";",
    escenarioPed,
    Long.toString(semillaPed),
    Integer.toString(nGeneradosPed),
    "0",
    Integer.toString(nProcesadosHorizontePed),
    Integer.toString(nProcesadosPed),
    String.format(java.util.Locale.US, "%.6f", esperaMediaPed()),
    String.format(java.util.Locale.US, "%.6f", percentil90Ped()),
    String.format(java.util.Locale.US, "%.6f", proporcionMas30Ped()),
    String.format(java.util.Locale.US, "%.6f", lqPed()),
    Integer.toString(qMaxPed),
    String.format(java.util.Locale.US, "%.6f", ultimaDisipacionPed),
    String.format(java.util.Locale.US, "%.6f", utilizacionMediaPed()),
    String.format(java.util.Locale.US, "%.6f", dispersionUtilizacionPed()),
    Integer.toString(esperasPicoPed.size()),
    String.format(java.util.Locale.US, "%.6f", esperaMediaPicoPed()),
    String.format(java.util.Locale.US, "%.6f", p90PicoPed()));</Body></Function>
          <Function AccessType="public" StaticFunction="false"><ReturnModificator>VOID</ReturnModificator><ReturnType>void</ReturnType><Id>1791000000184</Id><Name>emitirResultadoPed</Name><X>1750</X><Y>375</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Body>if (resultadoEmitidoPed) return;
if (nGeneradosPed != nInyectadosPed || nProcesadosPed != nInyectadosPed)
    throw new IllegalStateException("Conservacion peatonal violada: inyectados=" + nInyectadosPed
        + ", generados=" + nGeneradosPed + ", procesados=" + nProcesadosPed);
resultadoEmitidoPed = true;
String linea = prefijoResultadoPed() + ";" + filaResultadoPed();
traceln(resumenPeatonal());
traceln(linea);
escribirFilaPed(linea);
if (modoFranjaPed) getEngine().finish();</Body></Function>
          <Function AccessType="public" StaticFunction="false"><ReturnModificator>VOID</ReturnModificator><ReturnType>void</ReturnType><Id>1791000000102</Id><Name>configurarMolinetesPed</Name><X>1500</X><Y>340</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Body>if (molinetesOperativosPed != 20 &amp;&amp; molinetesOperativosPed != 28)
    throw new IllegalArgumentException("La demo peatonal admite 20 o 28 molinetes");
molinetesPeatonales.setServiceSuspended(molinetePed21, molinetesOperativosPed &lt; 21);
molinetesPeatonales.setServiceSuspended(molinetePed22, molinetesOperativosPed &lt; 22);
molinetesPeatonales.setServiceSuspended(molinetePed23, molinetesOperativosPed &lt; 23);
molinetesPeatonales.setServiceSuspended(molinetePed24, molinetesOperativosPed &lt; 24);
molinetesPeatonales.setServiceSuspended(molinetePed25, molinetesOperativosPed &lt; 25);
molinetesPeatonales.setServiceSuspended(molinetePed26, molinetesOperativosPed &lt; 26);
molinetesPeatonales.setServiceSuspended(molinetePed27, molinetesOperativosPed &lt; 27);
molinetesPeatonales.setServiceSuspended(molinetePed28, molinetesOperativosPed &lt; 28);</Body></Function>
          <Function AccessType="public" StaticFunction="false"><ReturnModificator>VOID</ReturnModificator><ReturnType>void</ReturnType><Id>1792000000022</Id><Name>inicializarPed</Name><X>2000</X><Y>60</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Body>if (horizonteMetricasPedSeg &lt;= 0) throw new IllegalArgumentException("horizonteMetricasPedSeg debe ser positivo");
if (inicioPicoPedSeg &lt; 0 || finPicoPedSeg &lt;= inicioPicoPedSeg) throw new IllegalArgumentException("Cohorte pico invalida");
if (modoFranjaPed) {
    if (tamanoTandaPed &lt;= 0 || intervaloTandaPedSeg &lt;= 0 || servicioPedSeg &lt;= 0 || primeraTandaPedSeg &lt; 0)
        throw new IllegalArgumentException("Franja peatonal PENDIENTE DE CALIBRACION: completar tamanoTandaPed, "
            + "intervaloTandaPedSeg, servicioPedSeg y primeraTandaPedSeg con mediciones o rangos aprobados");
    if (horizonteArribosPedSeg &lt;= 0 || horizonteArribosPedSeg &gt; 9000)
        throw new IllegalArgumentException("horizonteArribosPedSeg debe estar en (0, 9000]");
    if (primeraTandaPedSeg &gt;= horizonteArribosPedSeg)
        throw new IllegalArgumentException("La primera tanda debe ocurrir antes del cierre de arribos");
    if (perfilPed15min == null || perfilPed15min.length != 10)
        throw new IllegalArgumentException("perfilPed15min: diez ventanas de 15 minutos");
    double suma = 0;
    for (double v : perfilPed15min) {
        if (!Double.isFinite(v) || v &lt; 0) throw new IllegalArgumentException("perfilPed15min invalido");
        suma += v;
    }
    if (suma &lt;= 0) throw new IllegalArgumentException("perfilPed15min sin demanda");
    horizonteCortePed = horizonteArribosPedSeg;
} else {
    if (tamanoTandaDemo &lt; 0 || intervaloTandaDemoSeg &lt;= 0 || cantidadTandasDemo &lt;= 0 || servicioDemoSeg &lt;= 0)
        throw new IllegalArgumentException("Parametros de la demo peatonal invalidos");
    horizonteCortePed = horizonteMetricasPedSeg;
}
// La semilla efectiva es semillaPed: el par E0-E1 y la fila CSV quedan atados al mismo valor.
getDefaultRandomGenerator().setSeed(semillaPed);
inicializadoPed = true;</Body></Function>
          <Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>int</ReturnType><Id>1792000000023</Id><Name>tamanoTandaActualPed</Name><X>2000</X><Y>95</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Body>if (!modoFranjaPed) return tamanoTandaDemo;
if (!usarPerfilPed) return tamanoTandaPed;
int ventana = Math.max(0, Math.min(perfilPed15min.length - 1, (int)Math.floor(time()/900.0)));
double media = 0;
for (double v : perfilPed15min) media += v;
media /= perfilPed15min.length;
return (int)Math.round(tamanoTandaPed * perfilPed15min[ventana] / media);</Body></Function>
          <Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>boolean</ReturnType><Id>1792000000024</Id><Name>drenadoPed</Name><X>2000</X><Y>130</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Body>return arribosCerradosPed &amp;&amp; nProcesadosPed == nInyectadosPed;</Body></Function>
          <Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>String</ReturnType><Id>1792000000025</Id><Name>prefijoResultadoPed</Name><X>2000</X><Y>165</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Body>return modoFranjaPed ? "CSV_PEATONAL" : "CSV_PEATONAL_DEMO";</Body></Function>
          <Function AccessType="public" StaticFunction="false"><ReturnModificator>VOID</ReturnModificator><ReturnType>void</ReturnType><Id>1792000000026</Id><Name>escribirFilaPed</Name><X>2000</X><Y>200</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Parameter><Name>linea</Name><Type>String</Type></Parameter><Body>if (archivoSalidaPed == null || archivoSalidaPed.trim().isEmpty()) return;
try {
    java.nio.file.Path ruta = java.nio.file.Paths.get(archivoSalidaPed).toAbsolutePath();
    java.nio.file.Files.write(ruta, java.util.Collections.singletonList(linea), java.nio.charset.StandardCharsets.UTF_8,
        java.nio.file.StandardOpenOption.CREATE, java.nio.file.StandardOpenOption.APPEND);
    traceln("Fila agregada a " + ruta);
} catch (java.io.IOException e) {
    throw new RuntimeException("No se pudo escribir " + archivoSalidaPed, e);
}</Body></Function>
          <Function AccessType="public" StaticFunction="false"><ReturnModificator>VOID</ReturnModificator><ReturnType>void</ReturnType><Id>1792000000027</Id><Name>emitirIncompletoPed</Name><X>2000</X><Y>235</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Body>// Si la inicializacion fallo, el error ya figura en consola y no hay corrida que reportar.
if (resultadoEmitidoPed || !inicializadoPed) return;
resultadoEmitidoPed = true;
String linea = "CSV_PEATONAL_INCOMPLETO;" + filaResultadoPed() + ";inyectados=" + nInyectadosPed + ";t=" + time();
traceln("ADVERTENCIA: la corrida termino sin drenar la cohorte; no usar como replica.");
traceln(linea);
escribirFilaPed(linea);</Body></Function>
          <Function AccessType="public" StaticFunction="false"><ReturnModificator>RETURNS_VALUE</ReturnModificator><ReturnType>QueuePath</ReturnType><Id>1792000000183</Id><Name>elegirColaPed</Name><X>2000</X><Y>270</Y><PublicFlag>true</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Label><X>10</X><Y>0</Y></Label><Parameter><Name>ped</Name><Type>Pasajero</Type></Parameter><Body>// Supuesto de comportamiento (plano hipotetico): cada pasajero elige, entre los molinetes
// habilitados, la cola que minimiza el desvio lateral a 1,3 m/s mas la espera estimada por
// las personas que ya estan en ella. Los molinetes suspendidos nunca se eligen.
java.util.List&lt;QueuePath&gt; colas = molinetesPeatonales.getQueues();
QueuePath mejor = null;
double mejorCosto = Double.MAX_VALUE;
for (int i = 0; i &lt; molinetesOperativosPed &amp;&amp; i &lt; colas.size(); i++) {
    QueuePath cola = colas.get(i);
    double desvioSeg = Math.abs(ped.getY() - cola.getEndPoint().y) / 10.0 / 1.3;
    double costo = desvioSeg + molinetesPeatonales.queueSize(cola) * ped.servicioAsignadoPed;
    if (costo &lt; mejorCosto) {
        mejorCosto = costo;
        mejor = cola;
    }
}
if (mejor == null) throw new IllegalStateException("No hay molinetes habilitados");
return mejor;</Body></Function>
        </Functions>
        <Events>
          <Event><Id>1791000000092</Id><Name>proximaTandaPed</Name><X>1750</X><Y>60</Y><Label><X>10</X><Y>0</Y></Label><PublicFlag>false</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Properties TriggerType="timeout" Mode="occuresOnce"><Timeout Class="CodeUnitValue"><Code>1e12</Code><Unit Class="TimeUnits">SECOND</Unit></Timeout><Rate Class="CodeUnitValue"><Code>1</Code><Unit Class="RateUnits">PER_MINUTE</Unit></Rate><Id>1791000000093</Id><OccurrenceAtTime>true</OccurrenceAtTime><OccurrenceDate>1789984800000</OccurrenceDate><OccurrenceTime Class="CodeUnitValue"><Code>1e12</Code><Unit Class="TimeUnits">SECOND</Unit></OccurrenceTime><RecurrenceCode Class="CodeUnitValue"><Code>1e12</Code><Unit Class="TimeUnits">SECOND</Unit></RecurrenceCode><Condition>false</Condition></Properties><Action>generarTandaPed();</Action></Event>
          <Event><Id>1791000000182</Id><Name>cierreMetricasPed</Name><X>1750</X><Y>80</Y><Label><X>10</X><Y>0</Y></Label><PublicFlag>false</PublicFlag><PresentationFlag>false</PresentationFlag><ShowLabel>true</ShowLabel><Properties TriggerType="timeout" Mode="occuresOnce"><Timeout Class="CodeUnitValue"><Code>1e12</Code><Unit Class="TimeUnits">SECOND</Unit></Timeout><Rate Class="CodeUnitValue"><Code>1</Code><Unit Class="RateUnits">PER_MINUTE</Unit></Rate><Id>1791000000183</Id><OccurrenceAtTime>true</OccurrenceAtTime><OccurrenceDate>1789984800000</OccurrenceDate><OccurrenceTime Class="CodeUnitValue"><Code>1e12</Code><Unit Class="TimeUnits">SECOND</Unit></OccurrenceTime><RecurrenceCode Class="CodeUnitValue"><Code>1e12</Code><Unit Class="TimeUnits">SECOND</Unit></RecurrenceCode><Condition>false</Condition></Properties><Action>actualizarAreaColaPed();
nProcesadosHorizontePed = nProcesadosPed;
if (drenadoPed()) emitirResultadoPed();</Action></Event>
