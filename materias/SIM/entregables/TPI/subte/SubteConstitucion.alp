					<Action><![CDATA[actualizarTransitoPed();
int minutos = 7 * 60 + (int)Math.floor(time() / 60.0);
traceln(String.format(java.util.Locale.US, "PROGRESO t=%.0f s (%02d:%02d) - hall %d (max %d) - cola %d - zona paga %d - procesados %d/%d - real %.0f s",
    time(), minutos / 60, minutos % 60, hallPed(), hallMaxPed, nEsperandoPed, pagaPed(), nProcesadosPed, nInyectadosPed, segundosRealesPed()));
if (!resultadoEmitidoPed) progresoPed.restart(intervaloProgresoPed());]]></Action>
