					<Id>1791000000084</Id>
					<Name><![CDATA[actualizarAreaColaPed]]></Name>
					<X>1500</X><Y>60</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double ahora = Math.min(time(), horizonteCortePed);
areaColaPed += nEsperandoPed * Math.max(0, ahora - tAreaColaPed);
tAreaColaPed = ahora;]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1791000000085</Id>
					<Name><![CDATA[entraColaPed]]></Name>
					<X>1500</X><Y>95</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
