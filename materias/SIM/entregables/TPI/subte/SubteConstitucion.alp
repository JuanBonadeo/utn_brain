				<Event>
					<Id>1795000000042</Id>
					<Name><![CDATA[proximoTrenRocaPed]]></Name>
					<X>463</X><Y>-561</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="occuresOnce">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1e12]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_MINUTE]]></Unit>
						</Rate>
						<Id>1795000000043</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1789984800000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[1e12]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1e12]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[// Vista: cada tren del Roca aparece en su via (la misma que el anden de su pasaje) y frena junto a los paragolpes.
// Un tren por ocurrencia: la fuente lee viaActualTrenPed recien cuando el tren sale, asi que dos inyecciones en el
// mismo instante terminarian en la misma via. Los trenes simultaneos salen con 1 s de diferencia.
if (!trenesRocaPed.isEmpty() && trenesRocaPed.peek()[0] <= time() + 1e-9) {
    viaActualTrenPed = (int) trenesRocaPed.poll()[1];
    trenesRocaFuente.inject();
}
if (!trenesRocaPed.isEmpty()) proximoTrenRocaPed.restart(Math.max(1, trenesRocaPed.peek()[0] - time()));]]></Action>
				</Event>
