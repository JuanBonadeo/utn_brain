					<Body><![CDATA[if (esperasPicoPed.isEmpty()) return 0;
double suma = 0;
for (double valor : esperasPicoPed) suma += valor;
return suma/esperasPicoPed.size();]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
