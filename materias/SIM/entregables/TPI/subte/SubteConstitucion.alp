				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1790000000085</Id>
					<Name><![CDATA[tamanoActual]]></Name>
					<X>1900</X><Y>135</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double base = modoDemo ? 300 : tamanoTanda;
int w = Math.min(9, (int)(time()/900));
double factor = usarPerfilSBASE ? perfil15min[w]/1853.2 : 1.0;
return Math.max(0, (int)Math.round(base*factor));]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1790000000086</Id>
					<Name><![CDATA[inicializar]]></Name>
					<X>1900</X><Y>160</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (escenario < 0 || escenario > 3 || molinetesBase < 1 || molinetesE1 < 1)
    throw new IllegalArgumentException("Escenario o cantidad de molinetes invalida");
if (!Double.isFinite(horizonteSeg) || horizonteSeg <= 0 || horizonteSeg > 9000 ||
    !Double.isFinite(primeraTandaSeg) || primeraTandaSeg < 0 || primeraTandaSeg >= horizonteSeg ||
    !Double.isFinite(fraccionDesvioE2) || fraccionDesvioE2 < 0 || fraccionDesvioE2 > 1)
    throw new IllegalArgumentException("Revisar horizonte, primera tanda y fraccion de desvio");
if (!modoDemo && (tamanoTanda <= 0 || !Double.isFinite(intervaloTandaSeg) || intervaloTandaSeg <= 0 ||
    !Double.isFinite(servicioSUBESeg) || servicioSUBESeg <= 0 ||
    (escenario == 3 && (!Double.isFinite(servicioEMVSeg) || servicioEMVSeg <= 0))))
    throw new IllegalArgumentException("Completar medicion: tamanoTanda, intervaloTandaSeg, servicioSUBESeg y servicioEMVSeg para E3");
if (perfil15min == null || perfil15min.length != 10) throw new IllegalArgumentException("Perfil: diez ventanas");
for (double v : perfil15min) if (!Double.isFinite(v) || v < 0) throw new IllegalArgumentException("Perfil invalido");
rngDesvio = new java.util.Random(semilla);
iniciado = true;
traceln((modoDemo ? "DEMO SINTETICA - NO CALIBRADA" : "PARAMETROS CARGADOS - PENDIENTE VALIDACION") + " E" + escenario);
proximaTanda.restart(primeraTandaSeg);
cierreFranja.restart(horizonteSeg);]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1790000000087</Id>
					<Name><![CDATA[generarTanda]]></Name>
					<X>1900</X><Y>185</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (time() >= horizonteSeg) return;
int total = tamanoActual();
int principal = 0;
for (int i=0; i<total; i++) {
    double u = rngDesvio.nextDouble(); // Se consume en todos los escenarios.
    if (escenario == 2 && u < fraccionDesvioE2) nDesviados++;
    else principal++;
}
nGenerados += total;
nPrincipal += principal;
if (principal > 0) {
    tandasAbiertas.add(time());
    source.inject(principal);
}
observarCola.restart(0.000001);
double siguiente = time() + intervaloSeg();
if (siguiente < horizonteSeg) proximaTanda.restart(intervaloSeg());]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1790000000088</Id>
					<Name><![CDATA[actualizarAreas]]></Name>
					<X>1900</X><Y>210</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double hasta = Math.min(time(), horizonteSeg);
double dt = Math.max(0, hasta - tArea);
areaCola += nEsperando * dt;
areaOcupados += nOcupados * dt;
tArea = hasta;]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1790000000089</Id>
					<Name><![CDATA[entraCola]]></Name>
					<X>1900</X><Y>235</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Agent]]></Type>
					</Parameter>
					<Body><![CDATA[actualizarAreas();
llegadas.put(agent, time());
nEsperando++;
ultimaCola = time();
// Excluir transferencias instantaneas hacia molinetes libres del maximo fisico.
qMax = Math.max(qMax, Math.max(0, nEsperando - Math.max(0, capacidadMolinetes()-nOcupados)));
observarCola.restart(0.000001);]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1790000000090</Id>
					<Name><![CDATA[iniciaServicio]]></Name>
					<X>1900</X><Y>260</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[Agent]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[unit]]></Name>
						<Type><![CDATA[Agent]]></Type>
					</Parameter>
					<Body><![CDATA[actualizarAreas();
Double llegada = llegadas.remove(agent);
if (llegada == null) throw new IllegalStateException("Pasajero sin instante de llegada");
double w = time() - llegada;
esperas.add(w); sumaEspera += w;
if (w > 30) nMas30++;
if (llegada >= 4500 && llegada < 6300) {
    esperasPico.add(w); sumaEsperaPico += w; nPico++;
    if (w > 30) nMas30Pico++;
}
nEsperando--; nOcupados++;
ultimaCola = time();
inicioPorUnidad.put(unit, time());
if (!ocupacionPorUnidad.containsKey(unit)) ocupacionPorUnidad.put(unit, 0.0);
observarCola.restart(0.000001);]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1790000000091</Id>
					<Name><![CDATA[liberaMolinete]]></Name>
					<X>1900</X><Y>285</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[unit]]></Name>
						<Type><![CDATA[Agent]]></Type>
					</Parameter>
					<Body><![CDATA[actualizarAreas();
nOcupados--;
double inicio = inicioPorUnidad.remove(unit);
double duracion = Math.max(0, Math.min(time(), horizonteSeg)-Math.min(inicio, horizonteSeg));
ocupacionPorUnidad.put(unit, ocupacionPorUnidad.get(unit)+duracion);]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1790000000092</Id>
					<Name><![CDATA[salePasajero]]></Name>
					<X>1900</X><Y>310</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[nProcesados++;
if (time() < horizonteSeg) nProcesadosFranja++;
observarCola.restart(0.000001);]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1790000000093</Id>
					<Name><![CDATA[observar]]></Name>
					<X>1900</X><Y>335</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (nEsperando == 0 && !tandasAbiertas.isEmpty()) {
    for (double t : tandasAbiertas) disipaciones.add(Math.max(0, ultimaCola-t));
    tandasAbiertas.clear();
}
if (cerrado && nProcesados == nPrincipal && !finalizado) {
    finalizado = true;
    if (nGenerados != nDesviados + nProcesados) throw new IllegalStateException("Balance de pasajeros");
    traceln(resumen());
    getEngine().finish();
}]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1790000000094</Id>
					<Name><![CDATA[cerrarFranja]]></Name>
					<X>1900</X><Y>360</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[actualizarAreas();
cerrado = true;
pendientesAlCierre = nPrincipal - nProcesadosFranja;
colaAlCierre = nEsperando;
observarCola.restart(0.000001);]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790000000095</Id>
					<Name><![CDATA[percentil90]]></Name>
					<X>1900</X><Y>385</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (esperas.isEmpty()) return Double.NaN;
java.util.ArrayList<Double> ordenadas = new java.util.ArrayList<Double>(esperas);
java.util.Collections.sort(ordenadas);
return ordenadas.get((int)Math.ceil(0.9*ordenadas.size())-1);]]></Body>
				</Function>
				<Function AccessType="public" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
