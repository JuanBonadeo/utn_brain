			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1783520381556</Id>
					<Name><![CDATA[actualizarAreas]]></Name>
					<X>530</X><Y>130</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double dt = time() - tUltimo;
areaPos += max(inv, 0) * dt;
areaNeg += max(-inv, 0) * dt;
tUltimo = time();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1783520460349</Id>
					<Name><![CDATA[elegirDemanda]]></Name>
					<X>530</X><Y>180</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double u = uniform();
if (u < 1.0/6) return 1;
else if (u < 1.0/6+1.0/3) return 2;
else if (u < 1.0/6+2.0/3) return 3;
else return 4;]]></Body>
				</Function>
			</Functions>
