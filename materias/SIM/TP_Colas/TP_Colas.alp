					<Parameter>
						<Name><![CDATA[q]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Action><![CDATA[actualizarAreas();
inv += q;
enTransito -= q;]]></Action>
				</DynamicEventClass>
