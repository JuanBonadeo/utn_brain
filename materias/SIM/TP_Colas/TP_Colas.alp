					<Action><![CDATA[actualizarAreas();
int posicion = inv + enTransito;
if (posicion < s) {
    int q = S - posicion;
    costoOrdenAcum += Ksetup + cUnit * q;
    enTransito += q;
    double lag = uniform(lagMin, lagMax);
    create_LlegadaPedido(lag, q);
}]]></Action>
				</Event>
			</Events>
