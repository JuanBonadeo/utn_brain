	<JavaClasses>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1506377763253</Id>
			<Name><![CDATA[Utilidades]]></Name>
			<Text><![CDATA[/**
 * Utilidades
 */	
public class Utilidades implements Serializable {

    /**
     * Default constructor
     */
    public Utilidades() {
    }

	@Override
	public String toString() {
		return super.toString();
	}
	public static double calcularPromedio(List <Integer> marks) {
		  Integer sum = 0;
		  if(!marks.isEmpty()) {
		    for (Integer mark : marks) {
		        sum += mark;
		    }
		    return sum.doubleValue() / marks.size();
		  }
		  return sum;
	}
	public static double calcularSumatoria(List <Double> marks) {
		  double sum = 0;
		  if(!marks.isEmpty()) {
		    for (double mark : marks) {
		        sum += mark;
		    }
		    return sum;
		  }
		  return sum;
	}
	public static double calcularPromedioDouble(List <Double> numeros) {		 
		  double sum = 0;
		  
		  for(double d : numeros) {
		      sum += d;
		  }
		  return sum/numeros.size();
	}
	/**
	 * This number is here for model snapshot storing purpose<br>
	 * It needs to be changed when this class gets changed
	 */ 
	private static final long serialVersionUID = 1L;

}]]></Text>
		</JavaClass>
