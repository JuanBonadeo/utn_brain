       RowBox[{
        RowBox[{"<", " ", "k"}], " ", "=", 
        RowBox[{"<", "kmax"}]}]}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"tiradas", "=", 
       RowBox[{"Append", "[", 
        RowBox[{"tiradas", ",", 
         RowBox[{"IntegerPart", "[", 
          RowBox[{"37", " ", 
           RowBox[{"RandomReal", "[", "]"}]}], "]"}]}], "]"}]}], ",", " ", 
      RowBox[{"(*", 
       RowBox[{
       "Ac\[AAcute]", " ", "se", " ", "le", " ", "agrega", " ", "al", " ", 
        "listado", " ", "\"\<tiradas\>\"", " ", "un", " ", "entero", " ", 
        "en", " ", "cada", " ", "repetici\[OAcute]n"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"media", "[", "k", "]"}], "=", 
       RowBox[{"Mean", "[", "tiradas", "]"}]}], ",", 
      RowBox[{"(*", 
       RowBox[{
       "Ac\[AAcute]", " ", "se", " ", "va", " ", "calculando", " ", "el", " ",
         "promedio", " ", "de", " ", "tiradas", " ", "y", " ", "se", " ", 
        "guarda", " ", "en", " ", "la", " ", "variable", " ", 
        "\"\<media\>\""}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"var", "[", "k", "]"}], "=", 
       RowBox[{"Variance", "[", "tiradas", "]"}]}], ",", " ", 
      RowBox[{"(*", 
       RowBox[{
       "Ac\[AAcute]", " ", "se", " ", "va", " ", "calculando", " ", "la", " ",
