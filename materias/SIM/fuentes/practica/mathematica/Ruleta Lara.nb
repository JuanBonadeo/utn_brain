Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"kmax", "=", 
    SuperscriptBox["10", "4"]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"m", "=", 
