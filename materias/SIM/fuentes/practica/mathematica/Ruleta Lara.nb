     FractionBox["1", "37"], " ", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"k", "=", "0"}], "36"], "k"}]}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "Esto", " ", "ser\[IAcute]a", " ", "el", " ", "promedio", " ", "de", " ", 
    "la", " ", "suma", " ", "de", " ", "0", " ", "a", " ", "36"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"s", "=", " ", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"k", "=", "0"}], "36"], 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"k", "-", "m"}], ")"}], "2"], " ", 
     FractionBox["1", "37"]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tiradas", "=", 
   RowBox[{"{", 
    RowBox[{"IntegerPart", "[", 
     RowBox[{"37", " ", 
      RowBox[{"RandomReal", "[", "]"}]}], "]"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", " ", 
   RowBox[{"(*", 
    RowBox[{"Ciclo", " ", "de", " ", "repetici\[OAcute]n", " ", "k", " ", 
