{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"$CLAUDE_PROJECT_DIR/scripts/session-sync.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
